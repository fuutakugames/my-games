    // Touch & Pointer Steering
    steeringZone.addEventListener('pointerdown', (e) => {
      sound.init();
      steeringTouchId = e.pointerId;
      const rect = steeringZone.getBoundingClientRect();
      const centerX = rect.left + rect.width * 0.5;
      steeringStartX = e.clientX * 0.65 + centerX * 0.35;
      STATE.isAccelerating = true;

      const maxDrag = Math.min(95, window.innerWidth * 0.22);
      const dx = e.clientX - steeringStartX;
      STATE.steerInput = Math.max(-1, Math.min(1, dx / maxDrag));

      try {
        steeringZone.setPointerCapture(e.pointerId);
      } catch (err) {}

      updateWheelVisual();
      updateAccelIndicator();
    });

    steeringZone.addEventListener('pointermove', (e) => {
      if (steeringTouchId !== e.pointerId) return;
      STATE.isAccelerating = true;
      const dx = e.clientX - steeringStartX;
      const maxDrag = Math.min(95, window.innerWidth * 0.22);
      STATE.steerInput = Math.max(-1, Math.min(1, dx / maxDrag));
      updateWheelVisual();
      updateAccelIndicator();
    });

    function releaseSteering(e) {
      if (steeringTouchId !== null && e && e.pointerId !== undefined && steeringTouchId !== e.pointerId) return;
      steeringTouchId = null;
      STATE.isAccelerating = false;
      updateAccelIndicator();
    }
    steeringZone.addEventListener('pointerup', releaseSteering);
    steeringZone.addEventListener('pointercancel', releaseSteering);
    steeringZone.addEventListener('pointerleave', releaseSteering);

