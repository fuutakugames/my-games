    /**************************************************************
     * 4. 2D OVERLAY FX CANVAS
     **************************************************************/
    const fxCanvas = document.getElementById('fx-canvas');
    const fxCtx = fxCanvas.getContext('2d');
    let confettiParticles = [];
    let sparkParticles = [];

    function resizeCanvases() {
      const w = window.innerWidth;
      const h = window.innerHeight;
      renderer.setSize(w, h);
      camera.aspect = w / h;
      camera.updateProjectionMatrix();
      fxCanvas.width = w;
      fxCanvas.height = h;
    }
    window.addEventListener('resize', resizeCanvases);
    resizeCanvases();

    function spawnSparks(count = 16) {
      const w = fxCanvas.width;
      const h = fxCanvas.height;
      const colors = ['#fde047', '#ff2a85', '#00f5d4', '#ffffff', '#fb923c'];
      for (let i = 0; i < count; i++) {
        const angle = Math.random() * Math.PI * 2;
        const speed = 4 + Math.random() * 10;
        sparkParticles.push({
          x: w * 0.5 + (Math.random() - 0.5) * 120,
          y: h * 0.62 + (Math.random() - 0.5) * 60,
          vx: Math.cos(angle) * speed,
          vy: Math.sin(angle) * speed - 2,
          life: 1.0,
          color: colors[i % colors.length],
          size: 4 + Math.random() * 5
        });
      }
    }

    function spawnConfetti() {
      confettiParticles = [];
      const w = fxCanvas.width;
      const h = fxCanvas.height;
      const colors = ['#ff2a85', '#fde047', '#00f5d4', '#38bdf8', '#a855f7', '#4ade80'];
      for (let i = 0; i < 110; i++) {
        confettiParticles.push({
          x: Math.random() * w,
          y: -Math.random() * h * 0.8,
          vx: (Math.random() - 0.5) * 4,
          vy: 2.5 + Math.random() * 4.5,
          rot: Math.random() * Math.PI * 2,
          vRot: (Math.random() - 0.5) * 0.2,
          w: 8 + Math.random() * 8,
          h: 6 + Math.random() * 6,
          color: colors[i % colors.length]
        });
      }
    }

    function render2DOverlayFX(dt) {
      const w = fxCanvas.width;
      const h = fxCanvas.height;
      fxCtx.clearRect(0, 0, w, h);

      if (STATE.mode === 'racing' && STATE.boostActiveTimer > 0) {
        const cx = w * 0.5;
        const cy = h * 0.42;
        const maxR = Math.hypot(w, h) * 0.75;
        fxCtx.save();
        for (let i = 0; i < 28; i++) {
          const angle = (i / 28) * Math.PI * 2 + (performance.now() * 0.015);
          const innerR = 95 + (Math.sin(i * 7 + performance.now() * 0.03) * 35);
          fxCtx.strokeStyle = i % 2 === 0 ? 'rgba(255, 255, 255, 0.65)' : 'rgba(253, 224, 71, 0.65)';
          fxCtx.lineWidth = 2.5 + (i % 3);
          fxCtx.beginPath();
          fxCtx.moveTo(cx + Math.cos(angle) * innerR, cy + Math.sin(angle) * innerR);
          fxCtx.lineTo(cx + Math.cos(angle) * maxR, cy + Math.sin(angle) * maxR);
          fxCtx.stroke();
        }
        fxCtx.restore();

        if (Math.random() < 0.45) {
          spawnSparks(3);
        }
      }

      for (let i = sparkParticles.length - 1; i >= 0; i--) {
        const p = sparkParticles[i];
        p.x += p.vx;
        p.y += p.vy;
        p.life -= dt * 2.2;
        if (p.life <= 0) {
          sparkParticles.splice(i, 1);
          continue;
        }
        fxCtx.fillStyle = p.color;
        fxCtx.globalAlpha = Math.max(0, p.life);
        fxCtx.beginPath();
        fxCtx.arc(p.x, p.y, p.size, 0, Math.PI * 2);
        fxCtx.fill();
      }
      fxCtx.globalAlpha = 1;

      if (STATE.mode === 'goal') {
        confettiParticles.forEach(c => {
          c.x += c.vx + Math.sin(performance.now() * 0.003 + c.rot) * 0.8;
          c.y += c.vy;
          c.rot += c.vRot;
          if (c.y > h + 20) {
            c.y = -20;
            c.x = Math.random() * w;
          }
          fxCtx.save();
          fxCtx.translate(c.x, c.y);
          fxCtx.rotate(c.rot);
          fxCtx.fillStyle = c.color;
          fxCtx.fillRect(-c.w / 2, -c.h / 2, c.w, c.h);
          fxCtx.restore();
        });
      }
    }

    /**************************************************************
