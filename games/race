    scene.add(cockpitHoodGroup);
    scene.add(previewTurntableGroup);

    let trackCurve = null;
    let starObjects = [];
    let jumpRamps = [];
    let nurikabeMonsters = [];
    let rivalCars = [];
    let tractorSmokePuffs = [];
    let policeLightMeshes = [];

    function createTrackSpline(courseType) {
      const points = [];
      const segments = 72;
      const baseRadius = 240; // 1.3x expanded radius
      const diff = CONFIG.difficulty;
      const isHard = diff === 'hard';
      const isOni = diff === 'oni';
      const isComplex = isHard || isOni;

      for (let i = 0; i < segments; i++) {
        const angle = (i / segments) * Math.PI * 2;
        let wave = 0;
        let y = 0;

        if (courseType === 'circuit') {
          if (isComplex) {
            wave = Math.sin(angle * 3) * 65 + Math.cos(angle * 5) * 32 + (isOni ? Math.sin(angle * 8) * 18 : 0);
            y = Math.sin(angle * 3) * 3.0 + Math.cos(angle * 5) * 1.8;
          } else {
            wave = Math.sin(angle * 2) * 44 + Math.cos(angle * 3) * 20;
            y = Math.sin(angle * 2) * 1.8;
          }
        } else if (courseType === 'town') {
          if (isComplex) {
            wave = Math.cos(angle * 4) * 62 + Math.sin(angle * 6) * 30 + (isOni ? Math.cos(angle * 9) * 16 : 0);
            y = 0;
          } else {
            wave = Math.sin(angle * 2) * 40 + Math.cos(angle * 3) * 18;
            y = 0;
          }
        } else {
          if (isComplex) {
            wave = Math.sin(angle * 3) * 65 + Math.cos(angle * 6) * 32 + (isOni ? Math.sin(angle * 9) * 18 : 0);
            y = Math.sin(angle * 4) * 3.6 + Math.cos(angle * 7) * 2.2;
          } else {
            wave = Math.sin(angle * 2) * 44 + Math.sin(angle * 4) * 20;
            y = Math.sin(angle * 3) * 2.8;
          }
        }

        const r = baseRadius + wave;
        const x = Math.cos(angle) * r;
        const z = Math.sin(angle) * r;
        points.push(new THREE.Vector3(x, y, z));
      }
      return new THREE.CatmullRomCurve3(points, true, 'catmullrom', 0.5);
    }

    function getTrackFrame(s) {
      const u = ((s % TRACK_LENGTH) + TRACK_LENGTH) % TRACK_LENGTH / TRACK_LENGTH;
      const pos = trackCurve.getPointAt(u);
      const tangent = trackCurve.getTangentAt(u).normalize();
      const up = new THREE.Vector3(0, 1, 0);
      const right = new THREE.Vector3().crossVectors(tangent, up).normalize();
      const normal = new THREE.Vector3().crossVectors(right, tangent).normalize();
      return { u, pos, tangent, right, normal };
    }

    function getTrackCurvature(s) {
      const f1 = getTrackFrame(s - 4);
      const f2 = getTrackFrame(s + 4);
      const diff = new THREE.Vector3().subVectors(f2.tangent, f1.tangent);
      return diff.dot(f1.right) * 10;
    }

    function createCheckerTexture() {
      const c = document.createElement('canvas');
      c.width = 256;
      c.height = 64;
      const ctx = c.getContext('2d');
      const size = 16;
      for (let y = 0; y < c.height; y += size) {
        for (let x = 0; x < c.width; x += size) {
          ctx.fillStyle = ((x / size + y / size) % 2 === 0) ? '#ffffff' : '#1e1b4b';
          ctx.fillRect(x, y, size, size);
        }
      }
      const tex = new THREE.CanvasTexture(c);
      tex.wrapS = THREE.RepeatWrapping;
      tex.wrapT = THREE.RepeatWrapping;
      return tex;
    }

    function createRoadTexture(courseType) {
      const c = document.createElement('canvas');
      c.width = 512;
      c.height = 512;
      const ctx = c.getContext('2d');

      if (courseType === 'offroad') {
        ctx.fillStyle = '#9a5b25';
        ctx.fillRect(0, 0, 512, 512);

        ctx.fillStyle = '#854d1e';
        ctx.fillRect(110, 0, 75, 512);
        ctx.fillRect(327, 0, 75, 512);

        for (let i = 0; i < 180; i++) {
          ctx.fillStyle = i % 2 === 0 ? '#b4692c' : '#783f12';
          const px = (i * 73) % 480 + 16;
          const py = (i * 137) % 500;
          ctx.fillRect(px, py, 8, 12);
        }

        ctx.fillStyle = '#fde68a';
        ctx.fillRect(18, 0, 12, 512);
        ctx.fillRect(482, 0, 12, 512);
      } else {
        ctx.fillStyle = courseType === 'circuit' ? '#3b3759' : '#475569';
        ctx.fillRect(0, 0, 512, 512);

        ctx.fillStyle = '#ffffff';
        ctx.fillRect(18, 0, 14, 512);
        ctx.fillRect(480, 0, 14, 512);

        ctx.fillStyle = courseType === 'circuit' ? '#fde047' : '#ffffff';
        for (let y = 0; y < 512; y += 64) {
          ctx.fillRect(248, y + 8, 16, 36);
        }
      }

      const tex = new THREE.CanvasTexture(c);
      tex.wrapS = THREE.RepeatWrapping;
      tex.wrapT = THREE.RepeatWrapping;
      tex.repeat.set(1, 120);
      return tex;
    }

    function clearGroup(group) {
      while (group.children.length > 0) {
        const child = group.children[0];
        group.remove(child);
      }
    }

    function buildWorld() {
      clearGroup(trackGroup);
      clearGroup(sceneryGroup);
      clearGroup(interactiveGroup);
      starObjects = [];
      jumpRamps = [];
      nurikabeMonsters = [];
      rivalCars = [];

      const diffSpec = DIFFICULTY_SPECS[CONFIG.difficulty];
      const roadHalfWidth = diffSpec.roadHalfWidth;
      const curbWidth = 1.6;
      const isCircuit = CONFIG.course === 'circuit';
      const isOffroad = CONFIG.course === 'offroad';

      if (isCircuit) {
        scene.background = new THREE.Color(0x60a5fa);
        scene.fog.color.setHex(0x93c5fd);
      } else if (isOffroad) {
        scene.background = new THREE.Color(0x38bdf8);
        scene.fog.color.setHex(0xfef08a);
      } else {
        scene.background = new THREE.Color(0x7dd3fc);
        scene.fog.color.setHex(0xbae6fd);
      }

      const groundGeo = new THREE.CircleGeometry(750, 48);
      groundGeo.rotateX(-Math.PI / 2);
      const groundMat = new THREE.MeshLambertMaterial({
        color: isCircuit ? 0x4ade80 : (isOffroad ? 0xca8a04 : 0x86efac)
      });
      const groundMesh = new THREE.Mesh(groundGeo, groundMat);
      groundMesh.position.y = -6.5;
      trackGroup.add(groundMesh);

      trackCurve = createTrackSpline(CONFIG.course);

      const steps = 700;
      const roadPositions = [];
      const roadUVs = [];
      const roadIndices = [];

      const curbPositions = [];
      const curbColors = [];
      const curbIndices = [];

      for (let i = 0; i <= steps; i++) {
        const u = i / steps;
        const pt = trackCurve.getPointAt(u % 1);
        const tan = trackCurve.getTangentAt(u % 1).normalize();
        const right = new THREE.Vector3().crossVectors(tan, new THREE.Vector3(0, 1, 0)).normalize();

        const leftEdge = pt.clone().addScaledVector(right, -roadHalfWidth);
        const rightEdge = pt.clone().addScaledVector(right, roadHalfWidth);

        roadPositions.push(leftEdge.x, leftEdge.y, leftEdge.z);
        roadPositions.push(rightEdge.x, rightEdge.y, rightEdge.z);

        roadUVs.push(0, u);
        roadUVs.push(1, u);

        const leftOuter = pt.clone().addScaledVector(right, -(roadHalfWidth + curbWidth));
        const rightOuter = pt.clone().addScaledVector(right, roadHalfWidth + curbWidth);

        curbPositions.push(
          leftOuter.x, leftOuter.y + 0.35, leftOuter.z,
          leftEdge.x, leftEdge.y + 0.05, leftEdge.z,
          rightEdge.x, rightEdge.y + 0.05, rightEdge.z,
          rightOuter.x, rightOuter.y + 0.35, rightOuter.z
        );

        const palette = isCircuit
          ? [new THREE.Color(0xff2a85), new THREE.Color(0xfde047), new THREE.Color(0x00f5d4), new THREE.Color(0xffffff)]
          : isOffroad
            ? [new THREE.Color(0x78350f), new THREE.Color(0xf59e0b), new THREE.Color(0x84cc16)]
            : [new THREE.Color(0xf97316), new THREE.Color(0xffffff)];
        const cCol = palette[i % palette.length];
        for (let k = 0; k < 4; k++) {
          curbColors.push(cCol.r, cCol.g, cCol.b);
        }

        if (i < steps) {
          const rIdx = i * 2;
          roadIndices.push(rIdx, rIdx + 1, rIdx + 2);
          roadIndices.push(rIdx + 1, rIdx + 3, rIdx + 2);

          const cIdx = i * 4;
          curbIndices.push(cIdx, cIdx + 1, cIdx + 4);
          curbIndices.push(cIdx + 1, cIdx + 5, cIdx + 4);
          curbIndices.push(cIdx + 2, cIdx + 3, cIdx + 6);
          curbIndices.push(cIdx + 3, cIdx + 7, cIdx + 6);
        }
      }

      const roadGeo = new THREE.BufferGeometry();
      roadGeo.setAttribute('position', new THREE.Float32BufferAttribute(roadPositions, 3));
      roadGeo.setAttribute('uv', new THREE.Float32BufferAttribute(roadUVs, 2));
      roadGeo.setIndex(roadIndices);
      roadGeo.computeVertexNormals();

      const roadMat = new THREE.MeshLambertMaterial({
        map: createRoadTexture(CONFIG.course),
        side: THREE.DoubleSide
      });
      trackGroup.add(new THREE.Mesh(roadGeo, roadMat));

      const curbGeo = new THREE.BufferGeometry();
      curbGeo.setAttribute('position', new THREE.Float32BufferAttribute(curbPositions, 3));
      curbGeo.setAttribute('color', new THREE.Float32BufferAttribute(curbColors, 3));
      curbGeo.setIndex(curbIndices);
      curbGeo.computeVertexNormals();

      const curbMat = new THREE.MeshLambertMaterial({ vertexColors: true, side: THREE.DoubleSide });
      trackGroup.add(new THREE.Mesh(curbGeo, curbMat));

      buildStartGoalGate(roadHalfWidth);

      if (isCircuit) {
        buildCircuitScenery(roadHalfWidth);
      } else if (isOffroad) {
        buildOffroadScenery(roadHalfWidth);
        spawnJumpRamp(roadHalfWidth);
      } else {
        buildTownScenery(roadHalfWidth);
      }

      buildCurveSigns(roadHalfWidth);

      if (CONFIG.difficulty === 'oni') {
        spawnNurikabeMonsters(roadHalfWidth);
      }

      buildClouds();
      spawnStars(roadHalfWidth);
      spawnRivals(roadHalfWidth);
    }

    function buildStartGoalGate(roadHalfWidth) {
      const gateGroup = new THREE.Group();
      const frame0 = getTrackFrame(0);
      gateGroup.position.copy(frame0.pos);
      gateGroup.lookAt(frame0.pos.clone().add(frame0.tangent));

      const pillarGeo = new THREE.CylinderGeometry(0.75, 0.9, 12, 12);
      const pillarMat = new THREE.MeshLambertMaterial({ color: 0xff2a85 });

      const leftPillar = new THREE.Mesh(pillarGeo, pillarMat);
      leftPillar.position.set(-(roadHalfWidth + 1.5), 6, 0);
      gateGroup.add(leftPillar);

      const rightPillar = new THREE.Mesh(pillarGeo, pillarMat);
      rightPillar.position.set(roadHalfWidth + 1.5, 6, 0);
      gateGroup.add(rightPillar);

      const bannerGeo = new THREE.BoxGeometry((roadHalfWidth + 2) * 2, 2.8, 1.2);
      const bannerMat = new THREE.MeshLambertMaterial({ map: createCheckerTexture() });
      const banner = new THREE.Mesh(bannerGeo, bannerMat);
      banner.position.set(0, 11.2, 0);
      gateGroup.add(banner);

      const stripGeo = new THREE.PlaneGeometry(roadHalfWidth * 2, 3.2);
      stripGeo.rotateX(-Math.PI / 2);
      const strip = new THREE.Mesh(stripGeo, bannerMat);
      strip.position.set(0, 0.08, 0);
      gateGroup.add(strip);

      sceneryGroup.add(gateGroup);
    }

    function spawnJumpRamp(roadHalfWidth) {
      const rampS = Math.floor(TRACK_LENGTH * 0.5);
      const frame = getTrackFrame(rampS);
      const group = new THREE.Group();
      group.position.copy(frame.pos);
      group.lookAt(frame.pos.clone().add(frame.tangent));

      const rampGeo = new THREE.BoxGeometry(roadHalfWidth * 1.8, 0.75, 5.5);
      const rampMat = new THREE.MeshLambertMaterial({ color: 0xd97706 });
      const rampMesh = new THREE.Mesh(rampGeo, rampMat);
      rampMesh.position.y = 0.35;
      group.add(rampMesh);

      // Warning flag on ramp
      const flagPole = new THREE.Mesh(new THREE.CylinderGeometry(0.1, 0.1, 4, 8), new THREE.MeshLambertMaterial({ color: 0xffffff }));
      flagPole.position.set(roadHalfWidth * 0.8, 2, 0);
      group.add(flagPole);

      const flag = new THREE.Mesh(new THREE.BoxGeometry(1.2, 0.8, 0.1), new THREE.MeshBasicMaterial({ color: 0xef4444 }));
      flag.position.set(roadHalfWidth * 0.8 + 0.6, 3.5, 0);
      group.add(flag);

      sceneryGroup.add(group);
      jumpRamps.push({ s: rampS, halfWidth: roadHalfWidth * 0.9, boostScale: 1.15 });
    }

    function createNurikabeMesh() {
      const group = new THREE.Group();
      const wallMat = new THREE.MeshLambertMaterial({ color: 0x94a3b8 });
      const darkStoneMat = new THREE.MeshLambertMaterial({ color: 0x64748b });
      const eyeWhiteMat = new THREE.MeshBasicMaterial({ color: 0xffffff });
      const pupilMat = new THREE.MeshBasicMaterial({ color: 0x0f172a });
      const mouthMat = new THREE.MeshBasicMaterial({ color: 0x450a0a });
      const cheekMat = new THREE.MeshBasicMaterial({ color: 0xf472b6 });

      const bodyW = 6.2;
      const bodyH = 5.4;
      const bodyD = 1.7;
      const body = new THREE.Mesh(new THREE.BoxGeometry(bodyW, bodyH, bodyD), wallMat);
      body.position.y = bodyH * 0.5 + 0.4;
      group.add(body);

      const topCap = new THREE.Mesh(new THREE.BoxGeometry(bodyW + 0.3, 0.45, bodyD + 0.2), darkStoneMat);
      topCap.position.y = bodyH + 0.55;
      group.add(topCap);

      for (const zDir of [-1, 1]) {
        const zFace = zDir * (bodyD * 0.5 + 0.06);
        for (const side of [-1, 1]) {
          const eye = new THREE.Mesh(new THREE.SphereGeometry(0.62, 12, 12), eyeWhiteMat);
          eye.scale.set(1.1, 0.95, 0.35);
          eye.position.set(side * 1.35, 4.1, zFace);
          group.add(eye);

          const pupil = new THREE.Mesh(new THREE.SphereGeometry(0.28, 10, 10), pupilMat);
          pupil.scale.set(1, 1, 0.4);
          pupil.position.set(side * 1.35, 4.05, zFace + zDir * 0.14);
          group.add(pupil);

          const cheek = new THREE.Mesh(new THREE.CircleGeometry(0.42, 12), cheekMat);
          if (zDir < 0) cheek.rotation.y = Math.PI;
          cheek.position.set(side * 2.15, 3.35, zFace + zDir * 0.02);
          group.add(cheek);
        }

        const mouth = new THREE.Mesh(new THREE.BoxGeometry(2.8, 0.95, 0.14), mouthMat);
        mouth.position.set(0, 2.55, zFace);
        group.add(mouth);
      }
      return group;
    }

    function spawnNurikabeMonsters(roadHalfWidth) {
      for (let s = 130; s < TRACK_LENGTH - 100; s += 140) {
        if (CONFIG.course === 'offroad' && Math.abs(s - TRACK_LENGTH * 0.5) < 60) continue;

        const mesh = createNurikabeMesh();
        interactiveGroup.add(mesh);

        const idx = Math.floor(s / 140);
        const baseLat = (idx % 2 === 0 ? -1 : 1) * (roadHalfWidth * 0.38);

        nurikabeMonsters.push({
          mesh,
          s,
          baseLat,
          lat: baseLat,
          halfWidth: 3.1,
          phase: idx * 1.7
        });
      }
    }

    function buildCurveSigns(roadHalfWidth) {
      for (let s = 65; s < TRACK_LENGTH; s += 75) {
        const curv = getTrackCurvature(s);
        if (Math.abs(curv) > 0.35) {
          const frame = getTrackFrame(s);
          const signSide = curv > 0 ? 1 : -1; // place on outer edge of turn
          const signGroup = new THREE.Group();
          signGroup.position.copy(frame.pos).addScaledVector(frame.right, signSide * (roadHalfWidth + 2.5));
          signGroup.lookAt(frame.pos.clone().add(frame.tangent));

          const pole = new THREE.Mesh(new THREE.CylinderGeometry(0.18, 0.18, 4.5, 8), new THREE.MeshLambertMaterial({ color: 0x334155 }));
          pole.position.y = 2.25;
          signGroup.add(pole);

          const board = new THREE.Mesh(new THREE.BoxGeometry(2.2, 1.5, 0.2), new THREE.MeshBasicMaterial({ color: 0xffffff }));
          board.position.y = 4.2;
          signGroup.add(board);

          sceneryGroup.add(signGroup);
        }
      }
    }

    function buildCircuitScenery(roadHalfWidth) {
      const archColors = [0xff2a85, 0xfde047, 0x00f5d4, 0x38bdf8, 0xa855f7];
      for (let s = 30; s < TRACK_LENGTH; s += 38) {
        const frame = getTrackFrame(s);
        const objGroup = new THREE.Group();
        objGroup.position.copy(frame.pos);
        objGroup.lookAt(frame.pos.clone().add(frame.tangent));

        if (s % 76 === 40) {
          const archGeo = new THREE.TorusGeometry(roadHalfWidth + 2.5, 0.55, 8, 24, Math.PI);
          const col = archColors[(s / 38) % archColors.length | 0];
          const archMat = new THREE.MeshLambertMaterial({ color: col, emissive: col, emissiveIntensity: 0.25 });
          const arch = new THREE.Mesh(archGeo, archMat);
          arch.rotation.y = Math.PI;
          objGroup.add(arch);
        }

        for (const side of [-1, 1]) {
          const dist = roadHalfWidth + 10 + (s % 7);
          const towerH = 8 + (s % 12);
          const crystalGeo = new THREE.ConeGeometry(2.8, towerH, 6);
          const col = archColors[(s + (side > 0 ? 1 : 2)) % archColors.length];
          const crystal = new THREE.Mesh(crystalGeo, new THREE.MeshLambertMaterial({ color: col }));
          crystal.position.set(side * dist, towerH / 2 - 1, 0);
          objGroup.add(crystal);
        }
        sceneryGroup.add(objGroup);
      }
    }

    function buildTownScenery(roadHalfWidth) {
      const wallColors = [0xffedd5, 0xfce7f3, 0xe0f2fe, 0xfef9c3, 0xf3e8ff];
      const roofColors = [0xf43f5e, 0xf97316, 0x3b82f6, 0x10b981, 0xa855f7];

      for (let s = 25; s < TRACK_LENGTH; s += 28) {
        const frame = getTrackFrame(s);
        const slot = new THREE.Group();
        slot.position.copy(frame.pos);
        slot.lookAt(frame.pos.clone().add(frame.tangent));

        for (const side of [-1, 1]) {
          const treeGroup = new THREE.Group();
          const trunk = new THREE.Mesh(new THREE.CylinderGeometry(0.35, 0.5, 3.2, 8), new THREE.MeshLambertMaterial({ color: 0x92400e }));
          trunk.position.y = 1.6;
          treeGroup.add(trunk);

          const leaves = new THREE.Mesh(new THREE.SphereGeometry(2.1, 10, 10), new THREE.MeshLambertMaterial({ color: 0x22c55e }));
          leaves.position.y = 4.2;
          treeGroup.add(leaves);
          treeGroup.position.set(side * (roadHalfWidth + 3.2), 0, 0);
          slot.add(treeGroup);

          const idx = Math.floor(s / 28) + (side > 0 ? 2 : 0);
          const bGroup = new THREE.Group();
          const body = new THREE.Mesh(new THREE.BoxGeometry(6, 6, 6), new THREE.MeshLambertMaterial({ color: wallColors[idx % wallColors.length] }));
          body.position.y = 3;
          bGroup.add(body);

          const roof = new THREE.Mesh(new THREE.ConeGeometry(5.2, 3.8, 4), new THREE.MeshLambertMaterial({ color: roofColors[idx % roofColors.length] }));
          roof.position.y = 7.8;
          roof.rotation.y = Math.PI / 4;
          bGroup.add(roof);

          bGroup.position.set(side * (roadHalfWidth + 11.5), 0, 0);
          slot.add(bGroup);
        }
        sceneryGroup.add(slot);
      }
    }

    function buildOffroadScenery(roadHalfWidth) {
      const rockMat = new THREE.MeshLambertMaterial({ color: 0xb45309 });
      const woodMat = new THREE.MeshLambertMaterial({ color: 0x78350f });
      const pineMat = new THREE.MeshLambertMaterial({ color: 0x15803d });

      for (let s = 35; s < TRACK_LENGTH; s += 35) {
        const frame = getTrackFrame(s);
        const slot = new THREE.Group();
        slot.position.copy(frame.pos);
        slot.lookAt(frame.pos.clone().add(frame.tangent));

        if (s % 105 === 35) {
          const leftPost = new THREE.Mesh(new THREE.CylinderGeometry(0.65, 0.8, 10, 8), woodMat);
          leftPost.position.set(-(roadHalfWidth + 2.2), 5, 0);
          slot.add(leftPost);

          const rightPost = new THREE.Mesh(new THREE.CylinderGeometry(0.65, 0.8, 10, 8), woodMat);
          rightPost.position.set(roadHalfWidth + 2.2, 5, 0);
          slot.add(rightPost);

          const topLog = new THREE.Mesh(new THREE.CylinderGeometry(0.6, 0.6, (roadHalfWidth + 3.2) * 2, 8), woodMat);
          topLog.rotation.z = Math.PI / 2;
          topLog.position.set(0, 9.8, 0);
          slot.add(topLog);
        }

        for (const side of [-1, 1]) {
          const pineGroup = new THREE.Group();
          const trunk = new THREE.Mesh(new THREE.CylinderGeometry(0.4, 0.55, 2.5, 7), woodMat);
          trunk.position.y = 1.25;
          pineGroup.add(trunk);

          const cone1 = new THREE.Mesh(new THREE.ConeGeometry(2.6, 4.2, 7), pineMat);
          cone1.position.y = 3.8;
          pineGroup.add(cone1);

          pineGroup.position.set(side * (roadHalfWidth + 4.5), 0, 0);
          slot.add(pineGroup);
        }
        sceneryGroup.add(slot);
      }
    }

    function buildClouds() {
      const cloudMat = new THREE.MeshLambertMaterial({ color: 0xffffff });
      for (let i = 0; i < 22; i++) {
        const angle = (i / 22) * Math.PI * 2;
        const dist = 180 + (i % 3) * 60;
        const cGroup = new THREE.Group();
        for (let j = 0; j < 3; j++) {
          const puff = new THREE.Mesh(new THREE.SphereGeometry(5 + (j % 2) * 2, 8, 8), cloudMat);
          puff.position.set((j - 1) * 4.5, (j % 2) * 1.5, 0);
          cGroup.add(puff);
        }
        cGroup.position.set(Math.cos(angle) * dist, 40 + (i % 4) * 6, Math.sin(angle) * dist);
        sceneryGroup.add(cGroup);
      }
    }

    function spawnStars(roadHalfWidth) {
      const starGeo = new THREE.OctahedronGeometry(1.35, 0);
      const starMat = new THREE.MeshLambertMaterial({ color: 0xfde047, emissive: 0xf59e0b, emissiveIntensity: 0.45 });
      const ringGeo = new THREE.TorusGeometry(1.75, 0.14, 6, 16);
      const ringMat = new THREE.MeshBasicMaterial({ color: 0xffffff });

      for (let s = 40; s < TRACK_LENGTH - 30; s += 48) {
        const frame = getTrackFrame(s);
        const lat = Math.sin(s * 0.08) * (roadHalfWidth * 0.55);

        const group = new THREE.Group();
        group.add(new THREE.Mesh(starGeo, starMat));
        group.add(new THREE.Mesh(ringGeo, ringMat));

        group.position.copy(frame.pos).addScaledVector(frame.right, lat);
        group.position.y += 1.6;

        interactiveGroup.add(group);
        starObjects.push({ mesh: group, s, lat, active: true, respawnTimer: 0 });
      }
    }

    function createVehicleModel(carType, colorKey) {
      const palette = COLOR_PALETTE[colorKey] || COLOR_PALETTE.red;
      const group = new THREE.Group();

      const mainMat = new THREE.MeshLambertMaterial({ color: palette.main });
      const subMat = new THREE.MeshLambertMaterial({ color: palette.sub });
      const whiteMat = new THREE.MeshLambertMaterial({ color: 0xffffff });
      const darkMat = new THREE.MeshLambertMaterial({ color: 0x1e293b });
      const glassMat = new THREE.MeshLambertMaterial({ color: 0xbae6fd });

      if (carType === 'racer') {
        const body = new THREE.Mesh(new THREE.BoxGeometry(2.2, 0.65, 4.4), mainMat);
        body.position.y = 0.6;
        group.add(body);

        const nose = new THREE.Mesh(new THREE.BoxGeometry(1.5, 0.45, 1.6), subMat);
        nose.position.set(0, 0.5, 2.5);
        group.add(nose);

        const cabin = new THREE.Mesh(new THREE.BoxGeometry(1.4, 0.55, 1.8), glassMat);
        cabin.position.set(0, 1.1, -0.2);
        group.add(cabin);

        const wing = new THREE.Mesh(new THREE.BoxGeometry(2.6, 0.18, 0.7), subMat);
        wing.position.set(0, 1.45, -2.0);
        group.add(wing);
      } else if (carType === 'tractor') {
        const chassis = new THREE.Mesh(new THREE.BoxGeometry(2.0, 1.1, 3.6), mainMat);
        chassis.position.y = 1.05;
        group.add(chassis);

        const roof = new THREE.Mesh(new THREE.BoxGeometry(1.9, 1.2, 1.8), whiteMat);
        roof.position.set(0, 2.1, -0.7);
        group.add(roof);

        const chimney = new THREE.Mesh(new THREE.CylinderGeometry(0.2, 0.2, 1.6, 10), darkMat);
        chimney.position.set(0.55, 2.1, 1.1);
        group.add(chimney);
      } else if (carType === 'police') {
        const lower = new THREE.Mesh(new THREE.BoxGeometry(2.3, 0.75, 4.2), mainMat);
        lower.position.y = 0.65;
        group.add(lower);

        const upper = new THREE.Mesh(new THREE.BoxGeometry(1.9, 0.68, 2.2), whiteMat);
        upper.position.set(0, 1.32, -0.2);
        group.add(upper);

        const sirenRed = new THREE.Mesh(new THREE.BoxGeometry(1.3, 0.32, 0.42), new THREE.MeshBasicMaterial({ color: 0xff1744 }));
        sirenRed.position.set(0, 1.8, -0.1);
        group.add(sirenRed);
      }

      const wheelPositions = [
        [-1.2, 0.55, 1.35, 0.55],
        [ 1.2, 0.55, 1.35, 0.55],
        [-1.25, carType === 'tractor' ? 0.9 : 0.55, -1.35, carType === 'tractor' ? 0.9 : 0.55],
        [ 1.25, carType === 'tractor' ? 0.9 : 0.55, -1.35, carType === 'tractor' ? 0.9 : 0.55]
      ];
      wheelPositions.forEach(([wx, wy, wz, rad]) => {
        const wGeo = new THREE.CylinderGeometry(rad, rad, 0.55, 14);
        wGeo.rotateZ(Math.PI / 2);
        const w = new THREE.Mesh(wGeo, darkMat);
        w.position.set(wx, wy, wz);
        group.add(w);
      });

      return group;
    }

    function spawnRivals(roadHalfWidth) {
