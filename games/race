    function updateCockpitMeters() {
      const spd = Math.round(STATE.speedKmh);
      document.getElementById('digital-speed').textContent = spd;

      const spdRatio = Math.min(1, STATE.speedKmh / 240);
      const spdDeg = -75 + spdRatio * 150;
      document.getElementById('speed-needle').setAttribute('transform', `rotate(${spdDeg} 50 52)`);

      const rpmRatio = Math.min(1, (STATE.rpm - 1) / 7);
      const jitter = STATE.mode === 'racing' ? (Math.sin(performance.now() * 0.05) * 2.5) : 0;
      const rpmDeg = -75 + rpmRatio * 150 + jitter;
      document.getElementById('tacho-needle').setAttribute('transform', `rotate(${rpmDeg} 50 52)`);
      document.getElementById('rpm-text').textContent = STATE.rpm.toFixed(1);
