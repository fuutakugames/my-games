    function updateAccelIndicator() {
      if (STATE.isOffRoad && STATE.mode === 'racing') {
        accelLampUi.textContent = '🌱コースアウト';
        accelLampUi.className = 'px-1.5 py-0.5 rounded text-[9px] font-black bg-amber-500 text-white border border-white animate-pulse';
