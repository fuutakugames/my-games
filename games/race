    function runCountdownBanner() {
      const banner = document.getElementById('center-banner');
      banner.classList.remove('scale-0');
      banner.classList.add('scale-100');

      let step = 3;
      banner.textContent = '3';
      sound.playCount(false);

      const timer = setInterval(() => {
        if (STATE.mode !== 'countdown') {
          clearInterval(timer);
          return;
        }
        step--;
        if (step > 0) {
          banner.textContent = String(step);
          sound.playCount(false);
        } else if (step === 0) {
          banner.textContent = 'GO!! 🚀';
          sound.playCount(true);
          STATE.mode = 'racing';
          sound.startBGM();
        } else {
          banner.classList.remove('scale-100');
          banner.classList.add('scale-0');
          clearInterval(timer);
        }
      }, 850);
