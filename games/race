        { car: 'racer',   color: 'yellow', startS: 55, lat: -3.2, speedFactor: 0.95 },
        { car: 'police',  color: 'blue',   startS: 65, lat:  3.0, speedFactor: 0.98 },
        { car: 'racer',   color: 'green',  startS: 75, lat:  0.0, speedFactor: 1.00 }
