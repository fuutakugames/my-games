    function formatTime(sec) {
      const m = Math.floor(sec / 60);
      const s = Math.floor(sec % 60);
      const d = Math.floor((sec * 10) % 10);
      return `${String(m).padStart(2, '0')}:${String(s).padStart(2, '0')}.${d}`;
    }

    function updateBoostUI() {
      const starSlotsEl = document.getElementById('star-slots');
      let starsHtml = '';
      for (let i = 0; i < 3; i++) {
        const active = i < STATE.starsCollected || STATE.boostCharge >= 100;
        starsHtml += `<span class="${active ? 'opacity-100 scale-110 inline-block' : 'opacity-30'}">⭐</span>`;
      }
      starSlotsEl.innerHTML = starsHtml;

      document.getElementById('boost-bar-fill').style.width = `${Math.min(100, STATE.boostCharge)}%`;

      const boostBtn = document.getElementById('boost-btn');
