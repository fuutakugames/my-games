<!DOCTYPE html>
<html lang="ja">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no, viewport-fit=cover" />
  <title>きらきら★キッズグランプリ 3D</title>
  <!-- Tailwind CSS -->
  <script src="https://cdn.tailwindcss.com"></script>
  <!-- Google Fonts: M PLUS Rounded 1c for cute pop Japanese typography -->
  <link href="https://fonts.googleapis.com/css2?family=M+PLUS+Rounded+1c:wght@700;800;900&display=swap" rel="stylesheet">
  <!-- Three.js r128 -->
  <script src="https://cdnjs.cloudflare.com/ajax/libs/three.js/r128/three.min.js"></script>

  <style>
    * {
      box-sizing: border-box;
      user-select: none;
      -webkit-user-select: none;
      -webkit-touch-callout: none;
    }

    html, body {
      margin: 0;
      padding: 0;
      width: 100%;
      height: 100%;
      overflow: hidden;
      background: #1a103c;
      font-family: 'M PLUS Rounded 1c', sans-serif;
      overscroll-behavior: none;
    }

    #game-canvas {
      position: fixed;
      inset: 0;
      width: 100%;
      height: 100%;
      display: block;
      z-index: 1;
      touch-action: none;
    }

    #fx-canvas {
      position: fixed;
      inset: 0;
      width: 100%;
      height: 100%;
      pointer-events: none;
      z-index: 15;
    }

    /* Pop Text Stroke */
    .text-pop {
      text-shadow:
        0 3px 0 rgba(0, 0, 0, 0.28),
        -2px -2px 0 #fff,
        2px -2px 0 #fff,
        -2px 2px 0 #fff,
        2px 2px 0 #fff;
    }

    .text-pop-dark {
      text-shadow:
        0 3px 0 rgba(0, 0, 0, 0.45),
        -2px -2px 0 #2e1065,
        2px -2px 0 #2e1065,
        -2px 2px 0 #2e1065,
        2px 2px 0 #2e1065;
    }

    /* Option Button Styling */
    .choice-btn {
      transition: transform 0.15s cubic-bezier(0.34, 1.56, 0.64, 1), box-shadow 0.15s ease, border-color 0.15s ease;
      border: 3px solid rgba(255, 255, 255, 0.85);
      box-shadow: 0 4px 0 rgba(0, 0, 0, 0.18);
      cursor: pointer;
    }
    .choice-btn:active {
      transform: scale(0.95) translateY(2px);
    }
    .choice-btn.selected {
      transform: scale(1.05);
      border-color: #fde047;
      box-shadow: 0 0 0 3px #f43f5e, 0 6px 12px rgba(244, 63, 94, 0.4);
    }

    /* Rainbow Boost Flashing Animation */
    @keyframes rainbow-pulse {
      0%   { background: linear-gradient(135deg, #ff3b30, #ff9500); transform: scale(1); box-shadow: 0 0 18px #ff3b30, 0 5px 0 #991b1b; }
      25%  { background: linear-gradient(135deg, #ffcc00, #34c759); transform: scale(1.08); box-shadow: 0 0 26px #ffcc00, 0 5px 0 #166534; }
      50%  { background: linear-gradient(135deg, #00c7be, #007aff); transform: scale(1); box-shadow: 0 0 22px #00c7be, 0 5px 0 #1e40af; }
      75%  { background: linear-gradient(135deg, #af52de, #ff2d55); transform: scale(1.08); box-shadow: 0 0 26px #ff2d55, 0 5px 0 #831843; }
      100% { background: linear-gradient(135deg, #ff3b30, #ff9500); transform: scale(1); box-shadow: 0 0 18px #ff3b30, 0 5px 0 #991b1b; }
    }

    .boost-ready {
      animation: rainbow-pulse 0.7s infinite ease-in-out !important;
      border-color: #ffffff !important;
    }

    /* Boing Popup Animation */
    @keyframes boing-pop {
      0%   { transform: translate(-50%, -50%) scale(0.3) rotate(-12deg); opacity: 0; }
      40%  { transform: translate(-50%, -50%) scale(1.25) rotate(8deg); opacity: 1; }
      70%  { transform: translate(-50%, -50%) scale(0.95) rotate(-4deg); opacity: 1; }
      100% { transform: translate(-50%, -65%) scale(1) rotate(0deg); opacity: 0; }
    }
    .animate-boing {
      animation: boing-pop 0.85s cubic-bezier(0.34, 1.56, 0.64, 1) forwards;
    }

    /* Dashboard Glass & Bezel */
    .cockpit-dash {
      background: linear-gradient(180deg, rgba(30, 27, 60, 0.92) 0%, rgba(17, 14, 38, 0.99) 100%);
      border-top: 4px solid rgba(255, 255, 255, 0.35);
      box-shadow: 0 -8px 25px rgba(0, 0, 0, 0.45), inset 0 3px 8px rgba(255, 255, 255, 0.2);
    }

    .settings-scroll {
      overflow-y: auto;
      -webkit-overflow-scrolling: touch;
    }

    /* Interactive steering zone */
    #steering-zone {
      touch-action: none;
    }
  </style>
</head>
<body class="relative select-none overflow-hidden">

  <!-- 3D WebGL Canvas -->
  <canvas id="game-canvas"></canvas>

  <!-- 2D Overlay FX Canvas -->
  <canvas id="fx-canvas"></canvas>

  <!-- Top Sound Toggle Button -->
  <button id="sound-toggle-btn" class="fixed top-2 right-2 z-50 bg-white/90 hover:bg-white text-pink-600 font-black px-3 py-1.5 rounded-full shadow-md border-2 border-pink-300 text-xs sm:text-sm flex items-center gap-1 active:scale-95 cursor-pointer">
    <span id="sound-icon">🔊</span>
    <span id="sound-label">おと ON</span>
  </button>

  <!-- ==========================================
       1. TITLE & SETTINGS SCREEN
       ========================================== -->
  <div id="title-screen" class="fixed inset-0 z-30 flex flex-col justify-between items-center p-2 sm:p-4 pointer-events-auto">
    <!-- Top Header -->
    <div class="w-full max-w-md text-center mt-1 sm:mt-2 pointer-events-none">
      <div class="inline-block bg-gradient-to-r from-pink-500 via-purple-500 to-indigo-500 p-1 rounded-3xl shadow-xl">
        <div class="bg-white/95 px-4 py-1.5 rounded-[20px]">
          <h1 class="text-xl sm:text-2xl font-black tracking-tight bg-gradient-to-r from-pink-600 via-orange-500 to-purple-600 bg-clip-text text-transparent">
            🌈 きらきら★キッズグランプリ 3D 🏎️
          </h1>
        </div>
      </div>
      <div class="mt-1 flex justify-center">
        <span id="preview-car-badge" class="bg-yellow-300/95 text-purple-900 font-extrabold text-xs px-3 py-0.5 rounded-full shadow border border-white">
          ✨ えらんだ くるまが うえで まわるよ！ ✨
        </span>
      </div>
    </div>

    <!-- Spacer for 3D Turntable View -->
    <div class="flex-1 w-full min-h-[60px] sm:min-h-[100px] pointer-events-none"></div>

    <!-- Settings Panel Card -->
    <div class="settings-scroll w-full max-w-md bg-white/90 backdrop-blur-md rounded-3xl p-3 sm:p-4 border-4 border-pink-300 shadow-2xl max-h-[72vh] flex flex-col gap-2.5 pointer-events-auto">
      
      <!-- 1. なんいど (Difficulty) -->
      <div class="bg-pink-50/90 rounded-2xl p-2 border-2 border-pink-200">
        <div class="flex items-center justify-between mb-1.5">
          <span class="text-xs sm:text-sm font-black text-pink-600 flex items-center gap-1">
            ⭐ 1. なんいど を えらぼう
          </span>
          <span id="diff-desc" class="text-[11px] font-bold text-pink-500 bg-white px-2 py-0.5 rounded-full">
            ゆっくり・みちがひろいよ
          </span>
        </div>
        <div class="grid grid-cols-4 gap-1.5">
          <button data-group="difficulty" data-val="easy" class="choice-btn selected bg-gradient-to-b from-green-300 to-green-500 text-white rounded-xl py-1.5 px-1 flex flex-col items-center">
            <span class="text-base leading-none">🐣</span>
            <span class="text-xs font-black mt-0.5">かんたん</span>
          </button>
          <button data-group="difficulty" data-val="normal" class="choice-btn bg-gradient-to-b from-sky-300 to-sky-500 text-white rounded-xl py-1.5 px-1 flex flex-col items-center">
            <span class="text-base leading-none">🐰</span>
            <span class="text-xs font-black mt-0.5">ふつう</span>
          </button>
          <button data-group="difficulty" data-val="hard" class="choice-btn bg-gradient-to-b from-orange-400 to-orange-600 text-white rounded-xl py-1.5 px-1 flex flex-col items-center">
            <span class="text-base leading-none">🦁</span>
            <span class="text-xs font-black mt-0.5">むずかしい</span>
          </button>
          <button data-group="difficulty" data-val="oni" class="choice-btn bg-gradient-to-b from-purple-500 to-rose-600 text-white rounded-xl py-1.5 px-1 flex flex-col items-center">
            <span class="text-base leading-none">👹</span>
            <span class="text-xs font-black mt-0.5">おに</span>
          </button>
        </div>
      </div>

      <!-- 2. コース (Course) -->
      <div class="bg-sky-50/90 rounded-2xl p-2 border-2 border-sky-200">
        <div class="flex items-center justify-between mb-1.5">
          <span class="text-xs sm:text-sm font-black text-sky-700">
            🛣️ 2. コース を えらぼう
          </span>
        </div>
        <div class="grid grid-cols-3 gap-1.5">
          <button data-group="course" data-val="circuit" class="choice-btn selected bg-gradient-to-b from-indigo-500 to-pink-500 text-white rounded-xl py-1.5 px-1 flex flex-col items-center justify-center">
            <span class="text-lg leading-none">🏁</span>
            <span class="text-xs font-black mt-0.5">レーシング</span>
            <span class="text-[9px] opacity-90 leading-tight">キラキラ未来</span>
          </button>
          <button data-group="course" data-val="town" class="choice-btn bg-gradient-to-b from-emerald-400 to-teal-600 text-white rounded-xl py-1.5 px-1 flex flex-col items-center justify-center">
            <span class="text-lg leading-none">🏡</span>
            <span class="text-xs font-black mt-0.5">街なか</span>
            <span class="text-[9px] opacity-90 leading-tight">お家と信号機</span>
          </button>
          <button data-group="course" data-val="offroad" class="choice-btn bg-gradient-to-b from-amber-500 to-yellow-700 text-white rounded-xl py-1.5 px-1 flex flex-col items-center justify-center">
            <span class="text-lg leading-none">⛰️</span>
            <span class="text-xs font-black mt-0.5">オフロード</span>
            <span class="text-[9px] opacity-90 leading-tight">でこぼこ大自然</span>
          </button>
        </div>
      </div>

      <!-- 3. くるま (Vehicle) -->
      <div class="bg-amber-50/90 rounded-2xl p-2 border-2 border-amber-200">
        <div class="flex items-center justify-between mb-1.5">
          <span class="text-xs sm:text-sm font-black text-amber-700">
            🚗 3. くるま を えらぼう
          </span>
          <span id="car-desc" class="text-[11px] font-bold text-amber-600 bg-white px-2 py-0.5 rounded-full">
            スピードがとってもはやい！
          </span>
        </div>
        <div class="grid grid-cols-3 gap-1.5">
          <button data-group="car" data-val="racer" class="choice-btn selected bg-gradient-to-b from-rose-400 to-pink-600 text-white rounded-xl py-1.5 px-1 flex flex-col items-center">
            <span class="text-lg leading-none">🏎️</span>
            <span class="text-xs font-black mt-0.5">レーシングカー</span>
          </button>
          <button data-group="car" data-val="tractor" class="choice-btn bg-gradient-to-b from-amber-400 to-orange-500 text-white rounded-xl py-1.5 px-1 flex flex-col items-center">
            <span class="text-lg leading-none">🚜</span>
            <span class="text-xs font-black mt-0.5">トラクター</span>
          </button>
          <button data-group="car" data-val="police" class="choice-btn bg-gradient-to-b from-blue-400 to-indigo-600 text-white rounded-xl py-1.5 px-1 flex flex-col items-center">
            <span class="text-lg leading-none">🚓</span>
            <span class="text-xs font-black mt-0.5">パトカー</span>
          </button>
        </div>
      </div>

      <!-- 4. カラー (Color) -->
      <div class="bg-purple-50/90 rounded-2xl p-2 border-2 border-purple-200">
        <div class="text-xs sm:text-sm font-black text-purple-700 mb-1.5">
          🎨 4. カラー を えらぼう
        </div>
        <div class="grid grid-cols-4 gap-2">
          <button data-group="color" data-val="red" class="choice-btn selected bg-red-500 text-white rounded-xl py-1.5 font-black text-xs flex items-center justify-center gap-1">
            <span class="w-3 h-3 rounded-full bg-white inline-block"></span>あか
          </button>
          <button data-group="color" data-val="blue" class="choice-btn bg-blue-500 text-white rounded-xl py-1.5 font-black text-xs flex items-center justify-center gap-1">
            <span class="w-3 h-3 rounded-full bg-white inline-block"></span>あお
          </button>
          <button data-group="color" data-val="green" class="choice-btn bg-emerald-500 text-white rounded-xl py-1.5 font-black text-xs flex items-center justify-center gap-1">
            <span class="w-3 h-3 rounded-full bg-white inline-block"></span>みどり
          </button>
          <button data-group="color" data-val="yellow" class="choice-btn bg-amber-400 text-purple-950 rounded-xl py-1.5 font-black text-xs flex items-center justify-center gap-1">
            <span class="w-3 h-3 rounded-full bg-white inline-block"></span>きいろ
          </button>
        </div>
      </div>

      <!-- START BUTTON -->
      <button id="start-race-btn" class="w-full py-3 rounded-2xl bg-gradient-to-r from-pink-500 via-rose-500 to-yellow-400 text-white font-black text-xl sm:text-2xl tracking-wider shadow-[0_6px_0_#be123c] active:translate-y-1 active:shadow-[0_2px_0_#be123c] border-4 border-white flex items-center justify-center gap-2 cursor-pointer">
        <span>🏁</span>
        <span class="text-pop-dark">すたーと！</span>
        <span>✨</span>
      </button>
    </div>
  </div>

  <!-- ==========================================
       2. IN-GAME HUD & COCKPIT UI
       ========================================== -->
  <div id="race-hud" class="fixed inset-0 z-20 hidden flex-col justify-between pointer-events-none">
    
    <!-- Top Status Bar -->
    <div class="w-full max-w-xl mx-auto px-2 pt-2 flex flex-col gap-1.5 pointer-events-auto">
      <div class="flex items-center justify-between gap-1.5 pr-20">
        <!-- Rank Badge -->
        <div class="bg-gradient-to-b from-yellow-300 to-amber-500 px-2.5 py-1 rounded-2xl border-2 border-white shadow-lg flex items-baseline gap-1 shrink-0 whitespace-nowrap">
          <span class="text-xs font-black text-amber-950">じゅんい</span>
          <span id="hud-rank" class="text-2xl sm:text-3xl font-black text-white text-pop-dark">1</span>
          <span class="text-xs font-black text-amber-950">い</span>
        </div>

        <!-- Lap Counter -->
        <div class="bg-white/90 backdrop-blur px-2.5 py-1 rounded-2xl border-2 border-pink-400 shadow-lg flex items-center gap-1 shrink-0 whitespace-nowrap">
          <span class="text-sm">🏁</span>
          <span class="text-xs font-black text-pink-600">しゅうかい</span>
          <span id="hud-lap" class="text-base sm:text-xl font-black text-purple-900">1 / 3</span>
        </div>

        <!-- Timer -->
        <div class="bg-indigo-950/85 backdrop-blur px-2.5 py-1 rounded-2xl border-2 border-sky-300 shadow-lg flex items-center gap-1 shrink-0 whitespace-nowrap">
          <span class="text-xs font-bold text-sky-300">⏱️</span>
          <span id="hud-time" class="text-sm sm:text-base font-black text-white tabular-nums">00:00.0</span>
        </div>
      </div>

      <!-- Star & Boost Progress Bar + Return to Title button -->
      <div class="flex items-center justify-between gap-2">
        <div class="flex items-center gap-2 bg-purple-950/80 backdrop-blur px-3 py-1 rounded-full border-2 border-yellow-300 shadow">
          <span class="text-xs font-black text-yellow-300">きらきら星:</span>
          <div id="star-slots" class="flex items-center gap-1 text-base leading-none">
            <span class="opacity-30">⭐</span>
            <span class="opacity-30">⭐</span>
            <span class="opacity-30">⭐</span>
          </div>
          <!-- Mini Charge Bar -->
          <div class="w-16 sm:w-24 h-2.5 bg-gray-800 rounded-full overflow-hidden border border-white/50">
            <div id="boost-bar-fill" class="h-full bg-gradient-to-r from-yellow-300 via-pink-400 to-cyan-400 transition-all duration-100" style="width: 0%;"></div>
          </div>
        </div>

        <button id="back-to-menu-btn" class="bg-white/85 hover:bg-white text-purple-900 font-black text-xs px-2.5 py-1 rounded-full border-2 border-purple-300 shadow active:scale-95 cursor-pointer">
          🏠 もどる
        </button>
      </div>
    </div>

    <!-- Center Screen Notifications -->
    <div class="relative flex-1 w-full flex items-center justify-center overflow-hidden">
      <div id="center-banner" class="text-5xl sm:text-7xl font-black text-yellow-300 text-pop-dark tracking-wider text-center transition-transform duration-200 scale-0">
        3
      </div>
      <div id="popup-container" class="absolute inset-0 pointer-events-none"></div>
    </div>

    <!-- ==========================================
         BOTTOM COCKPIT DASHBOARD & CONTROLS
         ========================================== -->
    <div class="cockpit-dash w-full pt-2 pb-8 sm:pb-9 px-2 sm:px-4 rounded-t-[32px] pointer-events-auto relative">
      
      <!-- Top Row of Cockpit: Tachometer + Speed/Gear + Speedometer -->
      <div class="max-w-lg mx-auto flex items-center justify-between gap-1 mb-1 px-0.5">
        
        <!-- Tachometer -->
        <div class="flex items-center gap-1 bg-slate-900/90 px-2 py-1 rounded-2xl border-2 border-cyan-400/70 shadow-inner shrink-0">
          <svg viewBox="0 0 100 62" class="w-14 sm:w-20 h-9 sm:h-12 overflow-visible shrink-0">
            <path d="M 10 52 A 40 40 0 0 1 90 52" fill="none" stroke="#334155" stroke-width="9" stroke-linecap="round"/>
            <path d="M 10 52 A 40 40 0 0 1 68 17" fill="none" stroke="#22d3ee" stroke-width="7" stroke-linecap="round"/>
            <path d="M 68 17 A 40 40 0 0 1 90 52" fill="none" stroke="#f43f5e" stroke-width="7" stroke-linecap="round"/>
            <g id="tacho-needle" transform="rotate(-75 50 52)">
              <polygon points="48,52 50,15 52,52" fill="#fde047" />
              <circle cx="50" cy="52" r="5" fill="#ffffff"/>
            </g>
          </svg>
          <div class="text-left whitespace-nowrap">
            <div class="text-[9px] font-black text-cyan-300 leading-none">タコメーター</div>
            <div class="text-xs sm:text-sm font-black text-white tabular-nums leading-tight">
              <span id="rpm-text">2.5</span><span class="text-[8px] text-cyan-200 ml-0.5">x1000</span>
            </div>
          </div>
        </div>

        <!-- Center Digital Speed Readout & Status Lamps -->
        <div class="flex flex-col items-center justify-center bg-gradient-to-b from-indigo-950 to-slate-900 px-2.5 py-1 rounded-2xl border-2 border-pink-400 shadow-lg shrink-0">
          <div class="flex items-baseline gap-1 whitespace-nowrap">
            <span id="digital-speed" class="text-2xl sm:text-3xl font-black text-yellow-300 tabular-nums leading-none drop-shadow">0</span>
            <span class="text-[10px] font-black text-pink-300">km/h</span>
          </div>
          <div class="flex items-center gap-1 mt-0.5 whitespace-nowrap">
            <span id="accel-lamp-ui" class="px-1.5 py-0.5 rounded text-[9px] font-black bg-slate-800 text-slate-400 border border-slate-700 transition-colors">
              ニュートラル
            </span>
            <span id="brake-lamp-ui" class="px-1.5 py-0.5 rounded text-[9px] font-black bg-red-950 text-red-400 border border-red-800 transition-colors">
              ブレーキ灯
            </span>
          </div>
        </div>

        <!-- Speedometer -->
        <div class="flex items-center gap-1 bg-slate-900/90 px-2 py-1 rounded-2xl border-2 border-pink-400/70 shadow-inner shrink-0">
          <div class="text-right whitespace-nowrap">
            <div class="text-[9px] font-black text-pink-300 leading-none">スピード</div>
            <div class="text-[11px] sm:text-sm font-black text-white leading-tight">メーター</div>
          </div>
          <svg viewBox="0 0 100 62" class="w-14 sm:w-20 h-9 sm:h-12 overflow-visible shrink-0">
            <path d="M 10 52 A 40 40 0 0 1 90 52" fill="none" stroke="#334155" stroke-width="9" stroke-linecap="round"/>
            <path d="M 10 52 A 40 40 0 0 1 90 52" fill="none" stroke="url(#speedGrad)" stroke-width="7" stroke-linecap="round"/>
            <defs>
              <linearGradient id="speedGrad" x1="0%" y1="0%" x2="100%" y2="0%">
                <stop offset="0%" stop-color="#4ade80"/>
                <stop offset="60%" stop-color="#facc15"/>
                <stop offset="100%" stop-color="#f43f5e"/>
              </linearGradient>
            </defs>
            <g id="speed-needle" transform="rotate(-75 50 52)">
              <polygon points="48,52 50,15 52,52" fill="#f43f5e" />
              <circle cx="50" cy="52" r="5" fill="#ffffff"/>
            </g>
          </svg>
        </div>

      </div>

      <!-- Bottom Row of Cockpit: Brake Button + Enlarged Steering Wheel Zone + Boost Button -->
      <div class="max-w-lg mx-auto flex items-center justify-between gap-1.5 px-1">
        
        <!-- Left: Brake Button -->
        <button id="brake-btn" class="w-20 sm:w-24 h-32 sm:h-36 rounded-3xl bg-gradient-to-b from-rose-500 to-red-700 border-4 border-rose-200 shadow-[0_6px_0_#881337] active:translate-y-1 active:shadow-[0_2px_0_#881337] flex flex-col items-center justify-center text-white shrink-0 transition-transform cursor-pointer">
          <span class="text-2xl sm:text-3xl leading-none">🛑</span>
          <span class="text-xs sm:text-sm font-black mt-1 whitespace-nowrap">ブレーキ</span>
          <span class="text-[9px] opacity-85 font-bold whitespace-nowrap">おして減速</span>
        </button>

        <!-- Center: Enlarged Interactive Steering Wheel Zone (Avoids Gemini button interference) -->
        <div id="steering-zone" class="flex-1 flex flex-col items-center justify-center relative -mt-3 pb-1 cursor-grab active:cursor-grabbing">
          <div id="steering-hint" class="text-[10px] sm:text-xs font-black mb-1.5 flex items-center justify-center pointer-events-none whitespace-nowrap">
            <span id="steering-badge" class="bg-emerald-500/95 border border-white px-3 py-0.5 rounded-full text-white shadow">さわるとアクセルON!</span>
          </div>

          <!-- Larger Steering Wheel (176px width/height) -->
          <div id="steering-wheel-el" class="w-44 h-44 sm:w-48 sm:h-48 pointer-events-none will-change-transform transition-shadow rounded-full">
            <svg viewBox="0 0 120 120" class="w-full h-full drop-shadow-[0_8px_12px_rgba(0,0,0,0.65)]">
              <circle cx="60" cy="60" r="52" fill="none" stroke="#1e293b" stroke-width="16"/>
              <circle id="wheel-accent-ring" cx="60" cy="60" r="52" fill="none" stroke="#f43f5e" stroke-width="11" stroke-dasharray="46 20"/>
