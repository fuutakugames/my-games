    /**************************************************************
     * 8. 60FPS GAME LOOP & PHYSICS
     **************************************************************/
    let lastFrameTime = performance.now();

    function animate(now) {
      requestAnimationFrame(animate);
      const dt = Math.min(0.05, (now - lastFrameTime) / 1000);
      lastFrameTime = now;

      starObjects.forEach(st => {
        if (!st.active) {
          st.respawnTimer -= dt;
          if (st.respawnTimer <= 0) {
            st.active = true;
            st.mesh.visible = true;
          }
        } else {
          st.mesh.rotation.y += dt * 2.8;
          st.mesh.children[1].rotation.x += dt * 3.5;
        }
      });

      if (CONFIG.car === 'tractor' && tractorSmokePuffs.length > 0) {
        tractorSmokePuffs.forEach(p => {
          p.t = (p.t + dt * 1.4) % 1;
          p.mesh.position.y = -0.05 + p.t * 0.9;
          p.mesh.position.z = -2.2 - p.t * 0.2;
          const sc = 0.6 + p.t * 1.3;
          p.mesh.scale.set(sc, sc, sc);
          p.mesh.material.opacity = (1 - p.t) * 0.7;
        });
      }
      if (CONFIG.car === 'police' && policeLightMeshes.length === 2) {
        const flash = Math.sin(now * 0.018) > 0;
        policeLightMeshes[0].scale.setScalar(flash ? 1.35 : 0.85);
        policeLightMeshes[1].scale.setScalar(!flash ? 1.35 : 0.85);
      }

      if (STATE.mode === 'title') {
        const startFrame = getTrackFrame(0);
        previewTurntableGroup.position.copy(startFrame.pos).add(new THREE.Vector3(0, 1.2, 0));
        previewTurntableGroup.rotation.y = now * 0.0012;

        const camOffset = startFrame.tangent.clone().multiplyScalar(-10.5).add(new THREE.Vector3(0, 4.2, 0));
        camera.position.copy(startFrame.pos).add(camOffset);
        camera.lookAt(startFrame.pos.clone().add(new THREE.Vector3(0, -1.8, 0)));
        renderer.render(scene, camera);
        return;
      }

      if (steeringTouchId === null) {
        if (keysDown['ArrowLeft'] || keysDown['KeyA']) {
          STATE.steerInput = Math.max(-1, STATE.steerInput - dt * 3.5);
        } else if (keysDown['ArrowRight'] || keysDown['KeyD']) {
          STATE.steerInput = Math.min(1, STATE.steerInput + dt * 3.5);
        } else {
          STATE.steerInput *= Math.pow(0.0015, dt);
          if (Math.abs(STATE.steerInput) < 0.01) STATE.steerInput = 0;
        }
        updateWheelVisual();
      }

      const diffSpec = DIFFICULTY_SPECS[CONFIG.difficulty];
      const carSpec = CAR_SPECS[CONFIG.car];

      if (STATE.mode === 'racing') {
        STATE.raceTime += dt;
        document.getElementById('hud-time').textContent = formatTime(STATE.raceTime);

        const isBoosting = STATE.boostActiveTimer > 0;
        if (isBoosting) {
          STATE.boostActiveTimer = Math.max(0, STATE.boostActiveTimer - dt);
          if (STATE.boostActiveTimer === 0) {
            updateBoostUI();
          }
        } else {
          if (
            STATE.isAccelerating &&
            !STATE.isOffRoad &&
            STATE.speedKmh > 40 &&
            now - STATE.lastWallBounceTime > 1200 &&
            STATE.boostCharge < 100
          ) {
            const prevReady = STATE.boostCharge >= 100;
            STATE.boostCharge = Math.min(100, STATE.boostCharge + dt * diffSpec.boostChargeRate);
            if (!prevReady && STATE.boostCharge >= 100) {
              sound.playBoostReady();
              showFloatingPopup('🌟 ブースト 満タン！', 'from-amber-400 to-pink-500');
            }
            updateBoostUI();
          }
        }

        const baseMaxKmh = diffSpec.maxSpeed * carSpec.topSpeedBonus;
        let targetMaxKmh = 0;

        if (isBoosting) {
          targetMaxKmh = baseMaxKmh * (STATE.isOffRoad ? 0.85 : diffSpec.boostMultiplier);
        } else if (STATE.isBraking) {
          targetMaxKmh = 0;
        } else if (STATE.isAccelerating) {
          targetMaxKmh = STATE.isOffRoad ? baseMaxKmh * 0.42 : baseMaxKmh;
        } else {
          targetMaxKmh = 0;
        }

        if (STATE.speedKmh < targetMaxKmh) {
          const accelRate = isBoosting ? diffSpec.boostAccel : 68 * carSpec.accelRate;
          STATE.speedKmh = Math.min(targetMaxKmh, STATE.speedKmh + accelRate * dt);
        } else {
          let decelRate = 36;
          if (STATE.isBraking) decelRate = 145;
          else if (STATE.isOffRoad) decelRate = 95;
          STATE.speedKmh = Math.max(targetMaxKmh, STATE.speedKmh - decelRate * dt);
        }

        const targetRpm = STATE.isAccelerating || isBoosting
          ? 2.0 + (STATE.speedKmh / 240) * 5.0 + (isBoosting ? 1.0 : 0)
          : 1.2 + (STATE.speedKmh / 240) * 2.2;
        STATE.rpm += (targetRpm - STATE.rpm) * Math.min(1, dt * 10);

        const forwardMetersPerSec = STATE.speedKmh * diffSpec.worldSpeedScale;
        STATE.distance += forwardMetersPerSec * dt;

        const isAirborne = STATE.jumpY > 0.06;
        const airControlFactor = isAirborne ? 0.65 : 1.0;
        const steerSpeed = STATE.steerInput * 21.5 * carSpec.turnRate * airControlFactor;

        STATE.lateralOffset += (steerSpeed + STATE.lateralVel) * dt;
        STATE.lateralVel *= Math.pow(0.02, dt);

        const playerTrackS = ((STATE.distance % TRACK_LENGTH) + TRACK_LENGTH) % TRACK_LENGTH;
        if (jumpRamps.length > 0 && STATE.jumpY <= 0.05 && now - STATE.lastJumpTime > 420 && STATE.speedKmh > 35) {
          const ramp = jumpRamps[0];
          if (Math.abs(playerTrackS - ramp.s) < 3.2 && Math.abs(STATE.lateralOffset) <= ramp.halfWidth) {
            STATE.lastJumpTime = now;
            STATE.jumpVel = (8.2 + (STATE.speedKmh / 190) * 5.2) * ramp.boostScale;
            STATE.jumpY = 0.08;
            sound.playJump();
            spawnSparks(10);
            showFloatingPopup('🦘 ぴょーん！ジャンプ！', 'from-amber-400 via-orange-500 to-pink-500');
            if (STATE.boostCharge < 100 && STATE.boostActiveTimer <= 0) {
              STATE.boostCharge = Math.min(100, STATE.boostCharge + 8);
              updateBoostUI();
            }
          }
        }

        if (STATE.jumpY > 0 || STATE.jumpVel > 0) {
          STATE.jumpY += STATE.jumpVel * dt;
          STATE.jumpVel -= 25.0 * dt;
          if (STATE.jumpY <= 0) {
            STATE.jumpY = 0;
            STATE.jumpVel = 0;
            STATE.landingBounce = 1.0;
            sound.playLand();
          }
        }
        if (STATE.landingBounce > 0) {
          STATE.landingBounce = Math.max(0, STATE.landingBounce - dt * 4.5);
        }

        if (nurikabeMonsters.length > 0 && STATE.jumpY < 3.5) {
          for (let i = 0; i < nurikabeMonsters.length; i++) {
            const nk = nurikabeMonsters[i];
            const ds = Math.abs(playerTrackS - nk.s);
            const dLat = Math.abs(STATE.lateralOffset - nk.lat);
            if (ds < 3.0 && dLat < (nk.halfWidth + 0.85) && now - STATE.lastWallBounceTime > 550) {
              STATE.lastWallBounceTime = now;
              const pushDir = STATE.lateralOffset >= nk.lat ? 1 : -1;
              STATE.lateralVel = pushDir * 16.5;
              STATE.speedKmh *= 0.45;
              sound.playBoing();
              spawnSparks(14);
              showFloatingPopup('🧱 ぬりかべだ！ドスン！', 'from-slate-600 via-purple-600 to-rose-600');
              break;
            }
          }
        }

        if (!diffSpec.allowCourseOut) {
          STATE.isOffRoad = false;
          const maxLat = diffSpec.roadHalfWidth - 1.15;
          if (Math.abs(STATE.lateralOffset) > maxLat) {
            const sign = Math.sign(STATE.lateralOffset);
            STATE.lateralOffset = sign * maxLat;
            STATE.lateralVel = -sign * 12.5;
            STATE.speedKmh *= diffSpec.wallSlowdown;

            if (now - STATE.lastWallBounceTime > 550) {
              STATE.lastWallBounceTime = now;
              sound.playBoing();
              showFloatingPopup('ぽよん！🎈', 'from-pink-500 to-orange-400');
            }
          }
        } else {
          const roadEdge = diffSpec.roadHalfWidth - 0.5;
          const wasOffRoad = STATE.isOffRoad;
          STATE.isOffRoad = (STATE.jumpY <= 0.1) && (Math.abs(STATE.lateralOffset) > roadEdge);

          if (STATE.isOffRoad !== wasOffRoad) {
            updateAccelIndicator();
          }

          if (STATE.isOffRoad && now - STATE.lastOffRoadNoticeTime > 1600) {
            STATE.lastOffRoadNoticeTime = now;
            sound.playBrake();
            showFloatingPopup('🌱 コースアウト！みちにもどろう！', 'from-amber-500 to-green-600');
          }

          const outerLimit = diffSpec.roadHalfWidth + 6.2;
          if (Math.abs(STATE.lateralOffset) > outerLimit) {
            const sign = Math.sign(STATE.lateralOffset);
            STATE.lateralOffset = sign * outerLimit;
            STATE.lateralVel = -sign * 13.0;
            STATE.speedKmh *= 0.65;

            if (now - STATE.lastWallBounceTime > 550) {
              STATE.lastWallBounceTime = now;
              sound.playBoing();
              showFloatingPopup('ぽよん！みちにもどろう🎈', 'from-pink-500 to-orange-400');
            }
          }
        }

        starObjects.forEach(st => {
          if (!st.active) return;
          const ds = Math.abs(st.s - playerTrackS);
          const dLat = Math.abs(st.lat - STATE.lateralOffset);
          if (ds < 4.2 && dLat < 2.9) {
            st.active = false;
            st.mesh.visible = false;
            st.respawnTimer = 8.0;

            sound.playStar();
            spawnSparks(14);
            STATE.starsCollected = Math.min(3, STATE.starsCollected + 1);
            const prevCharge = STATE.boostCharge;
            STATE.boostCharge = Math.min(100, STATE.boostCharge + 34);
            if (STATE.starsCollected >= 3) STATE.boostCharge = 100;

            if (prevCharge < 100 && STATE.boostCharge >= 100) {
              showFloatingPopup('🌟 ターボ OK！おしてね！', 'from-yellow-400 via-pink-500 to-purple-500');
            } else {
              showFloatingPopup('⭐ きらきら星 ゲット！', 'from-yellow-300 to-amber-500');
            }
            updateBoostUI();
          }
        });

        const newLap = Math.floor(STATE.distance / TRACK_LENGTH) + 1;
        if (newLap > STATE.lap) {
          if (newLap > TOTAL_LAPS) {
            triggerGoalFinish();
          } else {
            STATE.lap = newLap;
            document.getElementById('hud-lap').textContent = `${STATE.lap} / ${TOTAL_LAPS}`;
            sound.playStar();
            showFloatingPopup(
              STATE.lap === TOTAL_LAPS ? '🔥 ファイナルラップ！！' : `🏁 ${STATE.lap}しゅうめ！`,
              'from-cyan-400 to-blue-600'
            );
          }
        }
      }

      nurikabeMonsters.forEach(nk => {
        nk.lat = nk.baseLat + Math.sin(now * 0.0018 + nk.phase) * 2.2;
        const nFrame = getTrackFrame(nk.s);
        nk.mesh.position.copy(nFrame.pos).addScaledVector(nFrame.right, nk.lat);
        nk.mesh.position.y += Math.abs(Math.sin(now * 0.005 + nk.phase)) * 0.35;
        const lookTarget = nFrame.pos.clone().add(nFrame.tangent).addScaledVector(nFrame.right, nk.lat);
        nk.mesh.lookAt(lookTarget);
      });

      let rivalsAhead = 0;
      rivalCars.forEach(rc => {
        if (STATE.mode === 'racing') {
          const rivalSpd = diffSpec.maxSpeed * diffSpec.worldSpeedScale * diffSpec.rivalSpeedRatio * rc.speedFactor;
          rc.distance += rivalSpd * dt;
          rc.lat = rc.baseLat + Math.sin(rc.distance * 0.03 + rc.phase) * 2.4;

          const distDiff = Math.abs(rc.distance - STATE.distance);
          const latDiff = Math.abs(rc.lat - STATE.lateralOffset);
          if (distDiff < 3.6 && latDiff < 2.2 && now - STATE.lastWallBounceTime > 550) {
            STATE.lastWallBounceTime = now;
            STATE.lateralVel = (STATE.lateralOffset >= rc.lat ? 1 : -1) * 11;
            sound.playBoing();
            showFloatingPopup('ぽよん！🚗', 'from-sky-400 to-indigo-500');
          }
        }

        const rFrame = getTrackFrame(rc.distance);
        rc.mesh.position.copy(rFrame.pos).addScaledVector(rFrame.right, rc.lat);
        if (jumpRamps.length > 0) {
          const rTrackS = ((rc.distance % TRACK_LENGTH) + TRACK_LENGTH) % TRACK_LENGTH;
          const distFromRamp = rTrackS - jumpRamps[0].s;
          if (distFromRamp >= -1 && distFromRamp <= 14) {
            const hop = Math.sin(((distFromRamp + 1) / 15) * Math.PI) * 2.2;
            rc.mesh.position.y += Math.max(0, hop);
          }
        }
        const lookPt = rFrame.pos.clone().add(rFrame.tangent.clone().multiplyScalar(5)).addScaledVector(rFrame.right, rc.lat);
        rc.mesh.lookAt(lookPt);

        if (rc.distance > STATE.distance) {
          rivalsAhead++;
        }
      });

      STATE.rank = 1 + rivalsAhead;
      document.getElementById('hud-rank').textContent = String(STATE.rank);

      const pFrame = getTrackFrame(STATE.distance);
      const carWorldPos = pFrame.pos.clone().addScaledVector(pFrame.right, STATE.lateralOffset);

      const targetFov = STATE.boostActiveTimer > 0 ? 78 : 62;
      camera.fov += (targetFov - camera.fov) * dt * 8;
      camera.updateProjectionMatrix();

      const suspensionDip = Math.sin(STATE.landingBounce * Math.PI) * 0.25;
      const eyePos = carWorldPos.clone().add(new THREE.Vector3(0, 1.55 + STATE.jumpY - suspensionDip, 0));
      camera.position.copy(eyePos);

      const jumpPitchOffset = STATE.jumpVel * 0.18;
      const lookAhead = carWorldPos.clone()
        .addScaledVector(pFrame.tangent, 16)
        .addScaledVector(pFrame.right, STATE.steerInput * 3.2)
        .add(new THREE.Vector3(0, 1.15 + STATE.jumpY * 0.85 + jumpPitchOffset, 0));
      camera.lookAt(lookAhead);
      camera.rotateZ(-STATE.steerInput * 0.055);

      cockpitHoodGroup.position.copy(camera.position);
      cockpitHoodGroup.quaternion.copy(camera.quaternion);
      let vib = 0;
      if (STATE.mode === 'racing' && STATE.jumpY <= 0.05) {
        vib = STATE.isOffRoad
          ? Math.sin(now * 0.085) * 0.065
          : Math.sin(now * 0.045) * (STATE.isAccelerating ? 0.014 : 0.005);
      }
      cockpitHoodGroup.translateY(vib);

      sound.updateEngine(STATE.speedKmh, STATE.mode === 'racing', STATE.isBraking, STATE.boostActiveTimer > 0);
      updateCockpitMeters();
      render2DOverlayFX(dt);

      renderer.render(scene, camera);
    }

    window.onload = function () {
      buildWorld();
      updateTitlePreviewCar();
      requestAnimationFrame(animate);
    };
  </script>
</body>
