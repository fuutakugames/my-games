<!DOCTYPE html>
<html lang="ja">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no" />
  <title>3Dぶっとび！くるま大ジャンプ＆だいクラッシュ</title>
  <script src="https://cdn.tailwindcss.com/3.4.17"></script>
  <script src="https://cdnjs.cloudflare.com/ajax/libs/three.js/r128/three.min.js"></script>
  <style>
    @import url('https://fonts.googleapis.com/css2?family=M+PLUS+Rounded+1c:wght@700;800;900&display=swap');
    * {
      box-sizing: border-box;
      user-select: none;
      -webkit-user-select: none;
      -webkit-touch-callout: none;
    }
    html, body {
      margin: 0;
      padding: 0;
      width: 100%;
      height: 100%;
      overflow: hidden;
      touch-action: none;
      font-family: 'M PLUS Rounded 1c', 'Hiragino Maru Gothic ProN', sans-serif;
      background: #090d16;
    }
    #canvas-container {
      position: fixed;
      inset: 0;
      width: 100%;
      height: 100%;
      z-index: 1;
      cursor: grab;
    }
    #canvas-container:active {
      cursor: grabbing;
    }
    .ui-layer {
      position: fixed;
      inset: 0;
      z-index: 10;
      pointer-events: none;
      display: flex;
      flex-direction: column;
      justify-content: space-between;
    }
    .interactive {
      pointer-events: auto;
    }
    .toy-btn {
      transition: transform 0.1s cubic-bezier(0.34, 1.56, 0.64, 1), box-shadow 0.1s ease;
    }
    .toy-btn:active {
      transform: translateY(3px) scale(0.96);
    }
    @keyframes pulse-big {
      0%, 100% { transform: scale(1); }
      50% { transform: scale(1.05); }
    }
    .animate-pulse-big {
      animation: pulse-big 1.2s infinite ease-in-out;
    }
    @keyframes pop-in {
      0% { transform: scale(0.4); opacity: 0; }
      80% { transform: scale(1.06); opacity: 1; }
      100% { transform: scale(1); opacity: 1; }
    }
    .animate-pop {
      animation: pop-in 0.32s cubic-bezier(0.34, 1.56, 0.64, 1) forwards;
    }
    @keyframes float-up-fade {
      0% { transform: translate(-50%, 0) scale(0.6); opacity: 0; }
      20% { transform: translate(-50%, -14px) scale(1.12); opacity: 1; }
      80% { transform: translate(-50%, -44px) scale(1); opacity: 1; }
      100% { transform: translate(-50%, -68px) scale(0.85); opacity: 0; }
    }
    .comic-popup {
      position: fixed;
      pointer-events: none;
      z-index: 25;
      animation: float-up-fade 1.15s cubic-bezier(0.22, 1, 0.36, 1) forwards;
      text-shadow: 0 3px 0 #000, 0 -2px 0 #000, 3px 0 0 #000, -3px 0 0 #000;
    }
    .car-scroll::-webkit-scrollbar {
      height: 6px;
      width: 6px;
    }
    .car-scroll::-webkit-scrollbar-thumb {
      background: rgba(255,255,255,0.4);
      border-radius: 9999px;
    }
  </style>
</head>
<body>

  <!-- 3D WebGL Canvas Container -->
  <div id="canvas-container"></div>

  <!-- Flash / Impact Overlay -->
  <div id="impact-flash" class="fixed inset-0 pointer-events-none z-20 opacity-0 transition-opacity duration-150 bg-white"></div>

  <!-- Comic Floating Text Layer -->
  <div id="comic-popup-layer" class="fixed inset-0 pointer-events-none z-25 overflow-hidden"></div>

  <!-- Main UI Layer -->
  <div class="ui-layer p-2 sm:p-3">

    <!-- TOP HUD BAR -->
    <div class="flex flex-wrap items-center justify-between gap-1.5 w-full">
      <!-- Selected Car, Distance & High Score Pill -->
      <div class="interactive flex items-center gap-2 bg-slate-950/90 backdrop-blur-md border-2 border-yellow-400/60 rounded-2xl px-3 py-1 text-white shadow-xl">
        <span id="hud-car-icon" class="text-2xl sm:text-3xl">🟢</span>
        <div class="leading-tight">
          <div class="flex items-center gap-2">
            <span id="hud-car-name" class="font-black text-xs sm:text-base text-yellow-300">みどりのランボルギーニ</span>
            <span id="hud-highscore" class="text-[10px] sm:text-xs bg-amber-500/20 border border-amber-400/50 text-amber-200 px-2 py-0.5 rounded-full font-black">🏆 ハイスコア: 0</span>
          </div>
          <div id="hud-course-label" class="text-[11px] sm:text-xs text-sky-300 font-bold">🎯 まと：450m（ふつう）</div>
        </div>
      </div>

      <!-- CAMERA ANGLE & ZOOM CONTROLLER BAR -->
      <div class="interactive flex items-center gap-1 bg-slate-950/90 backdrop-blur-md border-2 border-sky-400/70 rounded-2xl px-2 py-1 text-white shadow-xl">
        <span class="text-xs font-black text-sky-300 hidden md:inline mr-1">🎥 みるかくど：</span>
        <button id="cam-preset-back" type="button" class="cam-preset-btn toy-btn bg-sky-500 text-slate-950 font-black px-2 py-1 rounded-xl text-xs border border-white">
          うしろ
        </button>
        <button id="cam-preset-diag" type="button" class="cam-preset-btn toy-btn bg-slate-800 hover:bg-slate-700 text-white font-black px-2 py-1 rounded-xl text-xs border border-white/20">
          ななめ
        </button>
        <button id="cam-preset-side" type="button" class="cam-preset-btn toy-btn bg-slate-800 hover:bg-slate-700 text-white font-black px-2 py-1 rounded-xl text-xs border border-white/20">
          まよこ
        </button>
        <button id="cam-preset-front" type="button" class="cam-preset-btn toy-btn bg-slate-800 hover:bg-slate-700 text-white font-black px-2 py-1 rounded-xl text-xs border border-white/20">
          まえ
        </button>
        <button id="cam-preset-closeup" type="button" class="cam-preset-btn toy-btn bg-amber-500 text-slate-950 font-black px-2 py-1 rounded-xl text-xs border border-white">
          🔍ドアップ
        </button>
        <button id="cam-zoom-out" type="button" title="もっと遠くから見る" class="toy-btn bg-indigo-600 hover:bg-indigo-500 px-2 py-1 rounded-xl text-xs font-black border border-white/30">
          🔭ひき
        </button>
        <div class="h-4 w-[1px] bg-white/20 mx-0.5"></div>
        <button id="cam-rot-left" type="button" title="左へまわる" class="toy-btn bg-slate-700 hover:bg-slate-600 px-2 py-1 rounded-lg text-xs font-black">◀</button>
        <button id="cam-rot-right" type="button" title="右へまわる" class="toy-btn bg-slate-700 hover:bg-slate-600 px-2 py-1 rounded-lg text-xs font-black">▶</button>
        <button id="cam-rot-up" type="button" title="上から見る" class="toy-btn bg-slate-700 hover:bg-slate-600 px-1.5 py-1 rounded-lg text-xs font-black">▲</button>
        <button id="cam-rot-down" type="button" title="下から見る" class="toy-btn bg-slate-700 hover:bg-slate-600 px-1.5 py-1 rounded-lg text-xs font-black">▼</button>
      </div>

      <!-- Right Utility Buttons -->
      <div class="interactive flex items-center gap-1.5">
        <button id="btn-slowmo-toggle" type="button" class="toy-btn bg-purple-700 hover:bg-purple-600 border-2 border-purple-300 text-white font-black px-2.5 py-1.5 rounded-2xl text-xs sm:text-sm shadow-lg">
          🐢 スロー: じどう
        </button>
        <button id="btn-instant-crash" type="button" class="toy-btn bg-gradient-to-b from-rose-500 to-red-700 border-2 border-yellow-300 text-white font-black px-2.5 py-1.5 rounded-2xl text-xs sm:text-sm shadow-lg flex items-center gap-1">
          <span>💥</span><span class="hidden sm:inline">わざと こわす</span>
        </button>
        <button id="btn-sound-toggle" type="button" class="toy-btn bg-slate-800/90 hover:bg-slate-700 border-2 border-white/40 text-white font-black px-2.5 py-1.5 rounded-2xl text-xs sm:text-sm shadow-lg">
          🔊 おと ON
        </button>
        <button id="btn-pause" type="button" class="toy-btn bg-amber-500 hover:bg-amber-400 border-2 border-white text-slate-950 font-black px-2.5 py-1.5 rounded-2xl text-xs sm:text-sm shadow-lg">
          ⏸️ やすむ
        </button>
      </div>
    </div>

    <!-- Crash Camera Badge & Phase 3 Crash Target Focus Switcher -->
    <div class="flex flex-wrap items-center justify-center gap-2 pointer-events-none mt-1">
      <div id="crash-mode-badge" class="hidden bg-rose-600/95 border-4 border-yellow-300 text-white px-5 py-1 rounded-full font-black text-xs sm:text-base shadow-xl animate-bounce">
        💥 3Dだいクラッシュ カメラ！
      </div>
      <div id="crash-focus-bar" class="hidden interactive flex items-center gap-1 bg-slate-950/90 border-2 border-amber-300 rounded-full px-3 py-1 text-white text-xs shadow-xl">
        <span class="font-black text-amber-300">🔍 おいかける：</span>
        <button type="button" data-focus="chassis" class="focus-btn toy-btn bg-amber-400 text-slate-950 font-black px-2 py-0.5 rounded-full">🚗 くるま本体</button>
        <button type="button" data-focus="wheel" class="focus-btn toy-btn bg-slate-800 text-white font-black px-2 py-0.5 rounded-full">🛞 ころがるタイヤ</button>
        <button type="button" data-focus="fan" class="focus-btn toy-btn bg-slate-800 text-white font-black px-2 py-0.5 rounded-full">🌀 まわるファン</button>
      </div>
    </div>

    <!-- CENTER OVERLAYS (Title / Pause / Result / Floating Callouts) -->
    <div class="flex-1 flex items-center justify-center relative my-1 overflow-hidden">

      <!-- Floating Big Status Message -->
      <div id="floating-banner" class="hidden pointer-events-none fixed top-16 left-1/2 -translate-x-1/2 z-30 text-center">
        <div id="floating-banner-text" class="px-5 py-1 rounded-full font-black text-sm sm:text-xl text-white bg-slate-950/90 border-2 border-yellow-300 shadow-lg whitespace-nowrap">
          ナイスジャンプ！✨
        </div>
      </div>

      <!-- 1. TITLE & VEHICLE SELECT SCREEN (15 Vehicles!) -->
      <div id="screen-title" class="interactive w-full max-w-4xl self-end bg-slate-950/90 backdrop-blur-md border-4 border-sky-400 rounded-3xl p-3 sm:p-4 shadow-2xl text-white flex flex-col max-h-[75vh] overflow-y-auto car-scroll">
        <div class="flex flex-col sm:flex-row items-center justify-between gap-1 mb-2">
          <div>
            <h1 class="text-lg sm:text-2xl font-black tracking-tight text-white drop-shadow flex items-center gap-2">
              <span>🚗 3Dぶっとび！くるま大ジャンプ＆だいクラッシュ 💥</span>
            </h1>
            <p class="text-[11px] sm:text-xs text-sky-200 font-bold">
              ぜんぶで 15しゅるいの くるま！ まとを はずすと ゴロゴロ大回転して パーツが 次々に ぶっとぶよ！
            </p>
          </div>
          <span id="selected-car-spec" class="text-xs font-bold bg-sky-950 border border-sky-400/60 px-3 py-1 rounded-full text-yellow-300 whitespace-nowrap">
            シザードア＆リアV12黄金ツインファン超回転！
          </span>
        </div>

        <!-- 15 Vehicles Selection Grid -->
        <div class="mb-2">
          <div id="car-grid" class="grid grid-cols-3 sm:grid-cols-5 gap-1.5">
            <!-- Populated by JS -->
          </div>
        </div>

        <!-- Target Distance & Start Controls -->
        <div class="grid grid-cols-1 sm:grid-cols-12 gap-2 items-center bg-slate-900 rounded-2xl p-2 border border-white/15">
          <div class="sm:col-span-6 flex flex-col gap-1">
            <span class="text-[11px] font-black text-sky-200">🎯 まとの とおさ（コースを えらぶ）</span>
            <div class="grid grid-cols-3 gap-1.5">
              <button type="button" data-dist="320" class="dist-btn toy-btn py-1.5 px-2 rounded-xl font-black text-xs border-2 border-white/30 bg-emerald-600 text-white">
                🟢 ちかい<br><span class="text-[10px] opacity-90">320m</span>
              </button>
              <button type="button" data-dist="450" class="dist-btn toy-btn py-1.5 px-2 rounded-xl font-black text-xs border-4 border-yellow-300 bg-amber-500 text-slate-950 shadow-md">
                🟡 ふつう<br><span class="text-[10px] opacity-90">450m</span>
              </button>
              <button type="button" data-dist="580" class="dist-btn toy-btn py-1.5 px-2 rounded-xl font-black text-xs border-2 border-white/30 bg-rose-600 text-white">
                🔴 とおい<br><span class="text-[10px] opacity-90">580m</span>
              </button>
            </div>
          </div>

          <div class="sm:col-span-6 flex gap-2">
            <button id="btn-start-game" type="button" class="toy-btn animate-pulse-big flex-1 bg-gradient-to-b from-orange-400 via-orange-500 to-rose-600 hover:from-orange-300 hover:to-rose-500 border-4 border-yellow-200 text-white font-black py-2.5 px-4 rounded-2xl text-lg sm:text-xl shadow-xl flex items-center justify-center gap-2">
              <span>🚀</span><span>しゅっぱつ！</span>
            </button>
          </div>
        </div>
      </div>

      <!-- 2. PAUSE MODAL -->
      <div id="screen-pause" class="hidden interactive w-full max-w-md bg-slate-950/95 border-4 border-amber-400 rounded-3xl p-6 text-center text-white shadow-2xl">
        <div class="text-5xl mb-2">⏸️</div>
        <h2 class="text-2xl sm:text-3xl font-black text-amber-300 mb-4">ちょっと やすみちゅう</h2>
        <div class="flex flex-col gap-3">
          <button id="btn-resume" type="button" class="toy-btn bg-emerald-500 hover:bg-emerald-400 border-4 border-white text-slate-950 font-black py-3 rounded-2xl text-xl shadow-lg">
            ▶️ つづきから あそぶ
          </button>
          <button id="btn-pause-retry" type="button" class="toy-btn bg-sky-500 hover:bg-sky-400 border-4 border-white text-white font-black py-3 rounded-2xl text-xl shadow-lg">
            🔁 もういっかい 最初から
          </button>
          <button id="btn-pause-title" type="button" class="toy-btn bg-slate-700 hover:bg-slate-600 border-2 border-white/40 text-white font-black py-2.5 rounded-2xl text-base">
            🚗 くるまを えらびなおす
          </button>
        </div>
      </div>

      <!-- 3. INSTANT CRASH LAB MODAL (わざと こわす！6種類選択) -->
      <div id="screen-crash-picker" class="hidden interactive w-full max-w-xl bg-slate-950/95 border-4 border-rose-400 rounded-3xl p-4 sm:p-5 text-white shadow-2xl">
        <div class="flex items-center justify-between mb-2">
          <h2 class="text-lg sm:text-2xl font-black text-yellow-300">💥 どの こわれかたで ぶっこわす？</h2>
          <button id="btn-close-crash-picker" type="button" class="toy-btn bg-slate-700 px-3 py-1 rounded-xl font-black text-sm">✖ とじる</button>
        </div>
        <p class="text-xs sm:text-sm text-rose-200 font-bold mb-3">
          えらんだ こわれかたで、いまの くるまが リアルな物理演算で 3Dだいクラッシュするよ！
        </p>
        <div class="grid grid-cols-2 sm:grid-cols-3 gap-2">
          <button type="button" data-crash="tumble" class="crash-pick-btn toy-btn bg-gradient-to-b from-sky-500 to-indigo-700 border-2 border-yellow-200 p-2.5 rounded-2xl font-black text-left shadow-lg">
            <div class="text-2xl">🌪️🔄</div>
            <div class="text-sm sm:text-base">① ゴロゴロ大回転</div>
            <div class="text-[11px] text-yellow-100 opacity-90">激突して回転しながら次々に分解！</div>
          </button>
          <button type="button" data-crash="scatter" class="crash-pick-btn toy-btn bg-gradient-to-b from-orange-500 to-red-600 border-2 border-yellow-200 p-2.5 rounded-2xl font-black text-left shadow-lg">
            <div class="text-2xl">💥🛞</div>
            <div class="text-sm sm:text-base">② 高速スリップ分解</div>
            <div class="text-[11px] text-yellow-100 opacity-90">火花を散らして前へバラバラ飛ぶ！</div>
          </button>
          <button type="button" data-crash="squash" class="crash-pick-btn toy-btn bg-gradient-to-b from-amber-500 to-orange-600 border-2 border-yellow-200 p-2.5 rounded-2xl font-black text-left shadow-lg">
            <div class="text-2xl">🥞🔨</div>
            <div class="text-sm sm:text-base">③ フロント激突潰れ</div>
            <div class="text-[11px] text-yellow-100 opacity-90">前からグシャッと潰れて前転大破！</div>
          </button>
          <button type="button" data-crash="explode" class="crash-pick-btn toy-btn bg-gradient-to-b from-rose-600 to-purple-800 border-2 border-yellow-200 p-2.5 rounded-2xl font-black text-left shadow-lg">
            <div class="text-2xl">🔥💣</div>
            <div class="text-sm sm:text-base">④ 大爆発＆黒焦げ横転</div>
            <div class="text-[11px] text-yellow-100 opacity-90">爆風で黒焦げになり吹き飛ぶ！</div>
          </button>
          <button type="button" data-crash="pinball" class="crash-pick-btn toy-btn bg-gradient-to-b from-fuchsia-500 to-pink-600 border-2 border-yellow-200 p-2.5 rounded-2xl font-black text-left shadow-lg">
            <div class="text-2xl">🎪🍉</div>
            <div class="text-sm sm:text-base">⑤ 高速スピン激突</div>
            <div class="text-[11px] text-yellow-100 opacity-90">壁に跳ね返り超高速きりもみ分解！</div>
          </button>
          <button type="button" data-crash="water" class="crash-pick-btn toy-btn bg-gradient-to-b from-cyan-500 to-blue-600 border-2 border-yellow-200 p-2.5 rounded-2xl font-black text-left shadow-lg">
            <div class="text-2xl">💦🛟</div>
            <div class="text-sm sm:text-base">⑥ 水面バウンド水没</div>
            <div class="text-[11px] text-yellow-100 opacity-90">水しぶきを上げて水面で分解浮遊！</div>
          </button>
        </div>
      </div>

      <!-- 4. RESULT CARD -->
      <div id="screen-result" class="hidden interactive w-full max-w-xl self-end mb-1 bg-slate-950/92 backdrop-blur-md border-4 border-yellow-300 rounded-3xl p-3 text-white shadow-2xl animate-pop">
        <div class="flex flex-col sm:flex-row items-center justify-between gap-2">
          <div class="flex items-center gap-3 text-center sm:text-left">
            <div id="result-emoji" class="text-4xl sm:text-5xl">👑</div>
            <div>
              <div id="result-badge" class="inline-block text-xs font-black px-2.5 py-0.5 rounded-full bg-yellow-400 text-slate-950 mb-0.5">
                けっか はっぴょう！
              </div>
              <h2 id="result-title" class="text-lg sm:text-2xl font-black text-yellow-300 leading-tight">
                だいせいこう！ぴたっと ちゃくち！
              </h2>
              <p id="result-detail" class="text-xs sm:text-sm text-sky-200 font-bold">
                とんだ きょり：450m ／ パーツ ぶっとび：0こ
              </p>
            </div>
          </div>

          <div class="flex items-center gap-2 w-full sm:w-auto justify-center">
            <button id="btn-retry" type="button" class="toy-btn flex-1 sm:flex-initial bg-gradient-to-b from-emerald-400 to-emerald-600 border-4 border-white text-slate-950 font-black px-4 py-2 rounded-2xl text-base shadow-xl">
              🔁 もういっかい！
            </button>
            <button id="btn-change-car" type="button" class="toy-btn flex-1 sm:flex-initial bg-gradient-to-b from-sky-400 to-blue-600 border-4 border-white text-white font-black px-3 py-2 rounded-2xl text-sm shadow-xl">
              🚗 くるまをかえる
            </button>
          </div>
        </div>

        <div class="mt-2 pt-2 border-t border-white/15 flex flex-wrap items-center justify-between gap-1 text-xs">
          <span class="font-bold text-amber-200">🎥 画面ドラッグで ぐるぐる見られるよ！ こわれかたを えらぶ👉</span>
          <div class="flex flex-wrap gap-1">
            <button type="button" data-crash="tumble" class="crash-pick-btn toy-btn bg-indigo-600 hover:bg-indigo-500 border border-yellow-300 px-2 py-0.5 rounded-lg font-black">①ゴロゴロ</button>
            <button type="button" data-crash="scatter" class="crash-pick-btn toy-btn bg-rose-600 hover:bg-rose-500 border border-yellow-300 px-2 py-0.5 rounded-lg font-black">②スリップ分解</button>
            <button type="button" data-crash="squash" class="crash-pick-btn toy-btn bg-orange-600 hover:bg-orange-500 border border-yellow-300 px-2 py-0.5 rounded-lg font-black">③フロント潰れ</button>
            <button type="button" data-crash="explode" class="crash-pick-btn toy-btn bg-purple-700 hover:bg-purple-600 border border-yellow-300 px-2 py-0.5 rounded-lg font-black">④だいばくはつ</button>
            <button type="button" data-crash="pinball" class="crash-pick-btn toy-btn bg-pink-600 hover:bg-pink-500 border border-yellow-300 px-2 py-0.5 rounded-lg font-black">⑤高速スピン</button>
            <button type="button" data-crash="water" class="crash-pick-btn toy-btn bg-cyan-600 hover:bg-cyan-500 border border-yellow-300 px-2 py-0.5 rounded-lg font-black">⑥いけポチャ</button>
          </div>
        </div>
      </div>

    </div>

    <!-- BOTTOM ACTION CONTROLS (Shown during Run & Flight) -->
    <div id="hud-controls" class="hidden w-full max-w-3xl mx-auto flex flex-col gap-1.5 pb-1">

      <!-- Speed & Jump Progress Bar -->
      <div class="bg-slate-950/90 backdrop-blur-md border-2 border-white/30 rounded-2xl py-1 px-3 flex items-center gap-3 text-white shadow-lg">
        <div class="text-xs sm:text-sm font-black text-yellow-300 whitespace-nowrap" id="gauge-label">
          🔥 スピード
        </div>
        <div class="flex-1 h-3.5 bg-slate-800 rounded-full overflow-hidden border border-white/30 p-0.5">
          <div id="speed-bar" class="h-full w-0 rounded-full bg-gradient-to-r from-emerald-400 via-yellow-400 to-rose-500 transition-all duration-75"></div>
        </div>
        <div id="speed-readout" class="font-black text-xs sm:text-sm text-white w-28 text-right">
          0 km/h
        </div>
      </div>

      <!-- RUN PHASE BUTTON -->
      <div id="controls-run" class="interactive flex justify-center">
