    // =========================================================================
    function createAutomotiveEnvMap(rendererInstance) {
      const canvas = document.createElement('canvas');
      canvas.width = 512;
      canvas.height = 256;
      const ctx = canvas.getContext('2d');

      const grad = ctx.createLinearGradient(0, 0, 0, 256);
      grad.addColorStop(0.0, '#0f172a');
      grad.addColorStop(0.42, '#1e293b');
      grad.addColorStop(0.5, '#090d16');
      grad.addColorStop(1.0, '#020617');
      ctx.fillStyle = grad;
      ctx.fillRect(0, 0, 512, 256);

      ctx.fillStyle = 'rgba(255, 255, 255, 0.95)';
      ctx.fillRect(50, 36, 140, 10);
      ctx.fillRect(300, 32, 150, 12);
      ctx.fillStyle = 'rgba(253, 224, 71, 0.85)';
      ctx.beginPath();
      ctx.arc(380, 68, 16, 0, Math.PI * 2);
      ctx.fill();

      const tex = new THREE.CanvasTexture(canvas);
      tex.mapping = THREE.EquirectangularReflectionMapping;
      tex.needsUpdate = true;

      try {
        const pmrem = new THREE.PMREMGenerator(rendererInstance);
        pmrem.compileEquirectangularShader();
        const envRT = pmrem.fromEquirectangular(tex);
        pmrem.dispose();
        return envRT.texture;
      } catch (e) {
        return tex;
      }
    }

    function createCarPaintMaterial(hexColor, metalness = 0.22, roughness = 0.2) {
      return new THREE.MeshPhysicalMaterial({
