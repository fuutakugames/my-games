    function createSmoothRoundedBox(w, h, l, radius = 0.18, mat) {
      const r = Math.min(radius, w * 0.35, h * 0.35, l * 0.35);
      const wi = Math.max(0.05, w - r * 2);
      const hi = Math.max(0.05, h - r * 2);
      const li = Math.max(0.05, l - r * 2);

      const shape = new THREE.Shape();
      const hw = wi * 0.5;
      const hh = hi * 0.5;
      shape.moveTo(-hw, -hh + r);
      shape.lineTo(-hw, hh - r);
      shape.quadraticCurveTo(-hw, hh, -hw + r, hh);
      shape.lineTo(hw - r, hh);
      shape.quadraticCurveTo(hw, hh, hw, hh - r);
      shape.lineTo(hw, -hh + r);
      shape.quadraticCurveTo(hw, -hh, hw - r, -hh);
      shape.lineTo(-hw + r, -hh);
      shape.quadraticCurveTo(-hw, -hh, -hw, -hh + r);

      const geo = new THREE.ExtrudeGeometry(shape, {
        depth: li,
        bevelEnabled: true,
        bevelSegments: 6,
        steps: 1,
        bevelSize: r,
        bevelThickness: r,
        curveSegments: 16
      });
      geo.center();
      geo.computeVertexNormals();
      return new THREE.Mesh(geo, mat);
    }

    function createSculptedProfileMesh(points2D, width, bevel = 0.18, mat) {
      const shape = new THREE.Shape();
      shape.moveTo(points2D[0][0], points2D[0][1]);
      for (let i = 1; i < points2D.length; i++) {
        shape.lineTo(points2D[i][0], points2D[i][1]);
      }
      shape.closePath();

      const depth = Math.max(0.1, width - bevel * 2);
      const geo = new THREE.ExtrudeGeometry(shape, {
        depth,
        bevelEnabled: true,
        bevelSegments: 6,
        steps: 1,
        bevelSize: bevel,
        bevelThickness: bevel,
        curveSegments: 18
      });
      geo.center();
      geo.rotateY(Math.PI / 2);
      geo.computeVertexNormals();
      return new THREE.Mesh(geo, mat);
    }

    function createCoolingFanMesh(radius = 0.65, bladeColor = 0x0284c7) {
      const fanGroup = new THREE.Group();

      const shroud = new THREE.Mesh(
        new THREE.TorusGeometry(radius * 0.96, radius * 0.09, 14, 28),
        new THREE.MeshStandardMaterial({ color: 0x090d16, metalness: 0.7, roughness: 0.25 })
      );
      fanGroup.add(shroud);

      const hub = new THREE.Mesh(
        new THREE.ConeGeometry(radius * 0.28, 0.34, 20),
        new THREE.MeshStandardMaterial({ color: 0xfacc15, metalness: 0.75, roughness: 0.2 })
      );
      hub.rotation.x = Math.PI / 2;
      fanGroup.add(hub);

      const bladeMat = createCarPaintMaterial(bladeColor, 0.2, 0.2);
      for (let i = 0; i < 7; i++) {
        const blade = createSmoothRoundedBox(radius * 0.78, 0.18, 0.06, 0.02, bladeMat);
        const angle = (i / 7) * Math.PI * 2;
        blade.position.set(Math.cos(angle) * radius * 0.48, Math.sin(angle) * radius * 0.48, 0);
        blade.rotation.z = angle + 0.42;
        blade.rotation.y = 0.38;
        fanGroup.add(blade);
      }
      return fanGroup;
    }

    function createWheelMesh(radius = 0.85, width = 0.56, rimColor = 0xfacc15) {
      const wheelGroup = new THREE.Group();

      const rubberMat = new THREE.MeshStandardMaterial({
        color: 0x090d16,
        roughness: 0.8,
        metalness: 0.05
      });

      const torusR = radius * 0.78;
      const tubeR = radius * 0.22;
      [-width * 0.26, width * 0.26].forEach((tx) => {
        const shoulder = new THREE.Mesh(new THREE.TorusGeometry(torusR, tubeR, 18, 32), rubberMat);
        shoulder.rotation.y = Math.PI / 2;
        shoulder.position.x = tx;
        shoulder.castShadow = true;
        wheelGroup.add(shoulder);
      });

      const treadGeo = new THREE.CylinderGeometry(radius, radius, width * 0.65, 32);
      treadGeo.rotateZ(Math.PI / 2);
      const tread = new THREE.Mesh(treadGeo, rubberMat);
      tread.castShadow = true;
      wheelGroup.add(tread);

      const alloyMat = new THREE.MeshPhysicalMaterial({
        color: rimColor,
        metalness: 0.75,
        roughness: 0.18,
        clearcoat: 0.8,
        envMapIntensity: 0.6
      });
      const rimGeo = new THREE.CylinderGeometry(radius * 0.62, radius * 0.62, width * 0.82, 24);
      rimGeo.rotateZ(Math.PI / 2);
      const rim = new THREE.Mesh(rimGeo, alloyMat);
      wheelGroup.add(rim);

      const discGeo = new THREE.CylinderGeometry(radius * 0.46, radius * 0.46, width * 0.86, 20);
      discGeo.rotateZ(Math.PI / 2);
      const disc = new THREE.Mesh(
        discGeo,
        new THREE.MeshStandardMaterial({ color: 0x64748b, metalness: 0.8, roughness: 0.3 })
      );
      wheelGroup.add(disc);

      const spokeMat = new THREE.MeshStandardMaterial({ color: 0xe2e8f0, metalness: 0.8, roughness: 0.18 });
      for (let i = 0; i < 5; i++) {
        const angle = (i / 5) * Math.PI * 2;
        const spoke = createSmoothRoundedBox(width * 0.88, radius * 0.56, radius * 0.12, 0.03, spokeMat);
        spoke.position.set(0, Math.cos(angle) * radius * 0.28, Math.sin(angle) * radius * 0.28);
        spoke.rotation.x = -angle;
        wheelGroup.add(spoke);
      }

      const capGeo = new THREE.CylinderGeometry(radius * 0.18, radius * 0.18, width * 0.92, 16);
      capGeo.rotateZ(Math.PI / 2);
      const cap = new THREE.Mesh(capGeo, new THREE.MeshStandardMaterial({ color: 0xd90429, metalness: 0.6, roughness: 0.2 }));
      wheelGroup.add(cap);

      return wheelGroup;
    }

    // =========================================================================
    // 5. REALISTIC 3D MULTI-PART VEHICLE BUILDER
    // =========================================================================
    function buildVehicle3D(spec) {
      const rootGroup = new THREE.Group();
      const squashGroup = new THREE.Group();
      rootGroup.add(squashGroup);

      const parts = [];
      const spinningFans = [];
      const wheels = [];
      let gimmickPart = null;

      const registerPart = (mesh, partType, releaseStage = 1, opts = {}) => {
        mesh.traverse((child) => {
          if (child.isMesh) {
            child.castShadow = true;
            child.receiveShadow = true;
          }
        });
        squashGroup.add(mesh);
        parts.push({
          mesh,
          partType,
          releaseStage,
          detached: false,
          origPos: mesh.position.clone(),
          origRot: mesh.rotation.clone(),
          origScale: mesh.scale.clone(),
          vel: new THREE.Vector3(),
          angVel: new THREE.Vector3(),
          radius: opts.radius || 0.65,
          restitution: opts.restitution || (partType === 'wheel' ? 0.76 : partType === 'cargo' ? 0.72 : 0.42),
          rollOnGround: Boolean(opts.rollOnGround || partType === 'wheel' || partType === 'cargo'),
          alwaysSpin: Boolean(opts.alwaysSpin || partType === 'fan'),
          floatsInWater: opts.floatsInWater !== false
        });
        return mesh;
      };

      const mainMat = createCarPaintMaterial(spec.color, 0.22, 0.16);
      const accentMat = createCarPaintMaterial(spec.accent, 0.22, 0.18);
      const darkMat = new THREE.MeshStandardMaterial({ color: 0x090d16, roughness: 0.5, metalness: 0.25 });
      const chromeMat = new THREE.MeshPhysicalMaterial({
        color: 0xdbeafe,
        metalness: 0.85,
        roughness: 0.12,
        clearcoat: 1.0,
        envMapIntensity: 0.65
      });
      const glassMat = new THREE.MeshPhysicalMaterial({
        color: 0x020617,
        metalness: 0.15,
        roughness: 0.06,
        transparent: true,
        opacity: 0.9,
        clearcoat: 1.0,
        envMapIntensity: 0.8
      });

      // SPECIAL BUILD A: 🌾 こううんき
      if (spec.id === 'cultivator') {
        const wheelRadius = 0.72;
        const chassisY = wheelRadius + 0.1;

        [-1.05, 1.05].forEach((wx) => {
          const wMesh = createWheelMesh(wheelRadius, 0.45, 0xf8fafc);
          wMesh.position.set(wx, wheelRadius, 0.35);
          registerPart(wMesh, 'wheel', 3, { radius: wheelRadius, restitution: 0.78, rollOnGround: true });
          wheels.push(wMesh);

          const fender = createSmoothRoundedBox(0.55, 0.16, 1.25, 0.06, mainMat);
          fender.position.set(wx, wheelRadius * 2 + 0.08, 0.35);
          registerPart(fender, 'bumper', 1);
        });

        // Core frame stays with activeCar so it tumbles realistically!
        const gearbox = createSmoothRoundedBox(1.3, 0.65, 2.2, 0.14, darkMat);
        gearbox.position.set(0, chassisY + 0.1, 0.1);
        registerPart(gearbox, 'chassis', 99);

        const engineCover = createSmoothRoundedBox(1.45, 0.85, 1.45, 0.18, mainMat);
        engineCover.position.set(0, chassisY + 0.75, 0.65);
        registerPart(engineCover, 'hood', 2);

        const whiteTop = createSmoothRoundedBox(1.48, 0.32, 1.48, 0.12, accentMat);
        whiteTop.position.set(0, chassisY + 1.25, 0.65);
        registerPart(whiteTop, 'roof', 1);

        const frontFan = createCoolingFanMesh(0.62, 0xfacc15);
        frontFan.position.set(0, chassisY + 0.78, 1.45);
        registerPart(frontFan, 'fan', 3, { alwaysSpin: true });
        spinningFans.push(frontFan);

        [-0.58, 0.58].forEach((hx) => {
          const handleBar = createSmoothRoundedBox(0.14, 0.14, 2.6, 0.05, chromeMat);
          handleBar.position.set(hx, chassisY + 1.15, -1.25);
          handleBar.rotation.x = 0.36;
          registerPart(handleBar, 'door', 2);

          const grip = createSmoothRoundedBox(0.2, 0.2, 0.45, 0.06, darkMat);
          grip.position.set(hx, chassisY + 1.62, -2.42);
          registerPart(grip, 'light', 1);
        });

        const rotaryGroup = new THREE.Group();
        const shaft = new THREE.Mesh(new THREE.CylinderGeometry(0.22, 0.22, 2.2, 16), darkMat);
        shaft.rotation.z = Math.PI / 2;
        rotaryGroup.add(shaft);
        for (let i = -3; i <= 3; i++) {
          const tineWheel = createCoolingFanMesh(0.68, 0xe2e8f0);
          tineWheel.rotation.y = Math.PI / 2;
          tineWheel.position.x = i * 0.28;
          rotaryGroup.add(tineWheel);
        }
        rotaryGroup.position.set(0, 0.68, -1.35);
        gimmickPart = registerPart(rotaryGroup, 'fan', 2, { radius: 0.7, alwaysSpin: true, rollOnGround: true });
        spinningFans.push(rotaryGroup);

        const shield = createSmoothRoundedBox(2.35, 0.28, 1.15, 0.1, mainMat);
        shield.position.set(0, chassisY + 0.42, -1.35);
        registerPart(shield, 'special', 1);

        for (let i = 0; i < 14; i++) {
          const isCarrot = i % 2 === 0;
          const veg = new THREE.Mesh(
            new THREE.ConeGeometry(0.26, 0.85, 14),
            createCarPaintMaterial(isCarrot ? 0xea580c : 0xf8fafc, 0.1, 0.25)
          );
          veg.position.set(((i % 3) - 1) * 0.55, chassisY + 0.85 + Math.floor(i / 6) * 0.4, -0.8 - (i % 4) * 0.35);
          registerPart(veg, 'cargo', 1, { radius: 0.35, restitution: 0.76, rollOnGround: true });
        }

        return { rootGroup, squashGroup, parts, spinningFans, wheels, wheelRadius, gimmickPart };
      }

      // SPECIAL BUILD B: 🚜 あかのトラクター
      if (spec.id === 'tractor') {
        const frontR = 0.78;
        const rearR = 1.48;
        const chassisY = 0.92;

        [[-1.25, frontR, 1.75], [1.25, frontR, 1.75]].forEach(([wx, wy, wz]) => {
          const wMesh = createWheelMesh(frontR, 0.52, 0xfacc15);
          wMesh.position.set(wx, wy, wz);
          registerPart(wMesh, 'wheel', 2, { radius: frontR, restitution: 0.78, rollOnGround: true });
          wheels.push(wMesh);
        });
        [[-1.48, rearR, -1.25], [1.48, rearR, -1.25]].forEach(([wx, wy, wz]) => {
          const wMesh = createWheelMesh(rearR, 0.88, 0xfacc15);
          wMesh.position.set(wx, wy, wz);
          registerPart(wMesh, 'wheel', 3, { radius: rearR, restitution: 0.8, rollOnGround: true });
          wheels.push(wMesh);

          const fender = createSmoothRoundedBox(0.92, 0.24, 2.2, 0.1, mainMat);
          fender.position.set(wx * 0.88, rearR * 1.92, wz);
          registerPart(fender, 'bumper', 2);
        });

        const chassis = createSmoothRoundedBox(1.85, 0.55, 4.6, 0.14, darkMat);
        chassis.position.set(0, chassisY, 0.2);
        registerPart(chassis, 'chassis', 99);

        const nose = createSmoothRoundedBox(1.45, 1.25, 2.35, 0.2, mainMat);
        nose.position.set(0, chassisY + 0.85, 1.15);
        registerPart(nose, 'hood', 2);

        const tractorFan = createCoolingFanMesh(0.66, 0xfacc15);
        tractorFan.position.set(0, chassisY + 0.85, 2.38);
        registerPart(tractorFan, 'fan', 3, { alwaysSpin: true });
        spinningFans.push(tractorFan);

        const chimney = new THREE.Mesh(new THREE.CylinderGeometry(0.16, 0.2, 1.85, 16), darkMat);
        chimney.position.set(0.55, chassisY + 1.95, 1.25);
        gimmickPart = registerPart(chimney, 'exhaust', 1);

        const seat = createSmoothRoundedBox(0.95, 0.75, 0.85, 0.12, accentMat);
        seat.position.set(0, chassisY + 0.95, -0.95);
        registerPart(seat, 'door', 2);

        [-0.95, 0.95].forEach((px) => {
          const pillar = createSmoothRoundedBox(0.16, 1.95, 0.16, 0.04, darkMat);
          pillar.position.set(px, chassisY + 1.85, -1.25);
          registerPart(pillar, 'door', 1);
        });

        const canopy = createSmoothRoundedBox(2.25, 0.24, 1.95, 0.1, mainMat);
        canopy.position.set(0, chassisY + 2.85, -1.05);
        registerPart(canopy, 'roof', 1);

        for (let i = 0; i < 14; i++) {
          const isPumpkin = i % 2 === 0;
          const item = new THREE.Mesh(
            new THREE.SphereGeometry(0.42, 16, 16),
            createCarPaintMaterial(isPumpkin ? 0xea580c : 0xeab308, 0.15, 0.25)
          );
          item.position.set(((i % 3) - 1) * 0.68, chassisY + 0.75 + Math.floor(i / 6) * 0.55, -1.8 - (i % 4) * 0.45);
          registerPart(item, 'cargo', 1, { radius: 0.42, restitution: 0.76, rollOnGround: true });
        }

        return { rootGroup, squashGroup, parts, spinningFans, wheels, wheelRadius: frontR, gimmickPart };
      }

      // STANDARD & SUPERCAR BUILD
      const isMonster = spec.id === 'monster';
      const isBus = spec.id === 'bus';
      const isForklift = spec.id === 'forklift';
      const isLambo = spec.id === 'lambo';
      const isSports = spec.id === 'sports' || isLambo;

      const wheelRadius = isMonster ? 1.42 : isForklift ? 0.68 : 0.88;
      const wheelWidth = isMonster ? 0.92 : isLambo ? 0.66 : 0.56;
      const chassisY = wheelRadius + (isMonster ? 0.62 : isLambo ? 0.05 : 0.12);
      const length = isBus ? 7.8 : isForklift ? 4.3 : isLambo ? 5.9 : 5.6;
      const width = isMonster ? 3.1 : isLambo ? 2.82 : 2.6;

      // 1. Central Chassis stays attached to activeCar (`releaseStage = 99`) so the car's core body
      // tumbles, skids, and rolls along the asphalt realistically while shedding all its outer parts!
      const chassis = createSmoothRoundedBox(width * 0.92, 0.48, length * 0.9, 0.14, darkMat);
      chassis.position.set(0, chassisY, 0);
      registerPart(chassis, 'chassis', 99, { radius: 0.9 });

      [-0.55, 0.55].forEach((ex) => {
        const exhaust = new THREE.Mesh(new THREE.CylinderGeometry(0.16, 0.18, 0.75, 16), chromeMat);
        exhaust.rotation.x = Math.PI / 2;
        exhaust.position.set(ex, chassisY - 0.04, -length * 0.48);
        registerPart(exhaust, 'exhaust', 1, { radius: 0.25 });
      });

      // 2. Four Realistic Wheels (front wheels detach on stage 2, rear wheels on stage 3)
      const wheelZ = length * 0.33;
      const wheelX = width * 0.54;
      const wheelCoords = [
        [-wheelX, wheelRadius, wheelZ, 2],
        [wheelX, wheelRadius, wheelZ, 2],
        [-wheelX, wheelRadius, -wheelZ, 3],
        [wheelX, wheelRadius, -wheelZ, 3]
      ];
      wheelCoords.forEach(([wx, wy, wz, stage]) => {
        const wMesh = createWheelMesh(wheelRadius, wheelWidth, spec.accent);
        wMesh.position.set(wx, wy, wz);
        registerPart(wMesh, 'wheel', stage, { radius: wheelRadius, restitution: 0.78, rollOnGround: true });
        wheels.push(wMesh);

        if (!isForklift) {
          const arch = new THREE.Mesh(
            new THREE.TorusGeometry(wheelRadius * 1.05, 0.17, 12, 20, Math.PI),
            darkMat
          );
          arch.rotation.y = Math.PI / 2;
          arch.position.set(wx * 0.86, wy + 0.08, wz);
          registerPart(arch, 'bumper', 2, { radius: 0.45 });
        }
      });

      if (isMonster) {
        wheelCoords.forEach(([wx, wy, wz]) => {
          const spring = new THREE.Mesh(
            new THREE.CylinderGeometry(0.25, 0.25, 1.15, 16),
            createCarPaintMaterial(0xfacc15, 0.3, 0.2)
          );
          spring.position.set(wx * 0.76, wy + 0.62, wz);
          registerPart(spring, 'special', 2, { radius: 0.45, restitution: 0.8 });
        });
      }

      // 4. Engine Block + High-Speed Cooling Fan (detaches on stage 3)
      const engineGroup = new THREE.Group();
      const engBlock = createSmoothRoundedBox(1.22, 0.82, 1.12, 0.12, chromeMat);
      engineGroup.add(engBlock);
      const radiatorFan = createCoolingFanMesh(0.6, 0xef4444);
      radiatorFan.position.set(0, 0.08, 0.62);
      engineGroup.add(radiatorFan);
      spinningFans.push(radiatorFan);
      engineGroup.position.set(0, chassisY + 0.62, isLambo ? -length * 0.22 : length * 0.31);
      registerPart(engineGroup, 'fan', 3, { radius: 0.7, alwaysSpin: true });

      // 5. Sculpted Front Hood (detaches on stage 2)
      const hoodProfile = isLambo
        ? [[0, 0], [2.1, -0.32], [2.15, -0.08], [0, 0.28]]
        : isSports
        ? [[0, 0], [1.85, -0.22], [1.9, 0.05], [0, 0.32]]
        : [[0, 0], [1.65, -0.12], [1.7, 0.18], [0, 0.36]];
      const hood = createSculptedProfileMesh(hoodProfile, width * 0.92, 0.16, mainMat);
      hood.position.set(0, chassisY + (isLambo ? 0.88 : 1.05), length * 0.31);
      registerPart(hood, 'hood', 2, { radius: 0.6 });

      const grille = createSmoothRoundedBox(width * 0.68, 0.46, 0.18, 0.06, darkMat);
      grille.position.set(0, chassisY + 0.52, length * 0.49);
      registerPart(grille, 'bumper', 1, { radius: 0.35 });

      // 6. Front & Rear Bumpers + Headlights + Taillights (detach on first impact stage 1!)
      const frontBumper = createSmoothRoundedBox(width * 1.05, 0.42, 0.46, 0.16, isSports ? mainMat : darkMat);
      frontBumper.position.set(0, chassisY + 0.18, length * 0.5 + 0.12);
      registerPart(frontBumper, 'bumper', 1, { radius: 0.45 });

      const rearBumper = createSmoothRoundedBox(width * 1.05, 0.44, 0.44, 0.16, darkMat);
      rearBumper.position.set(0, chassisY + 0.18, -length * 0.5 - 0.12);
      registerPart(rearBumper, 'bumper', 1, { radius: 0.45 });

      [-width * 0.34, width * 0.34].forEach((lx) => {
        const hGroup = new THREE.Group();
        const bezel = new THREE.Mesh(new THREE.CylinderGeometry(0.26, 0.26, 0.18, 20), darkMat);
        bezel.rotation.x = Math.PI / 2;
        hGroup.add(bezel);
        const lens = new THREE.Mesh(
          new THREE.SphereGeometry(0.21, 16, 16),
          new THREE.MeshStandardMaterial({ color: 0xfacc15, emissive: 0xfacc15, emissiveIntensity: 0.95 })
        );
        lens.position.z = 0.06;
        hGroup.add(lens);
        hGroup.position.set(lx, chassisY + 0.65, length * 0.5 + 0.06);
        registerPart(hGroup, 'light', 1, { radius: 0.3 });

        const tail = createSmoothRoundedBox(
          0.52,
          0.24,
          0.16,
          0.06,
          new THREE.MeshStandardMaterial({ color: 0xef4444, emissive: 0xdc2626, emissiveIntensity: 0.85 })
        );
        tail.position.set(lx, chassisY + 0.68, -length * 0.5 - 0.04);
        registerPart(tail, 'light', 1, { radius: 0.25 });
      });

      // 7. Cabin, Doors, Side Mirrors & Dark Smoked Glass
      const cabinZ = isSports ? -0.08 : isBus ? 0 : length * 0.08;
      const cabinH = isLambo ? 0.88 : isSports ? 1.02 : 1.5;
      const cabinL = isBus ? length * 0.88 : isLambo ? 2.45 : 2.25;

      [-1, 1].forEach((side) => {
        const doorGroup = new THREE.Group();
        const doorPanel = createSmoothRoundedBox(0.24, cabinH * 0.68, 1.55, 0.09, mainMat);
        doorGroup.add(doorPanel);

        if (isLambo) {
          const scoop = createSmoothRoundedBox(0.28, 0.45, 0.65, 0.06, darkMat);
          scoop.position.set(side * 0.06, -0.05, -0.45);
          doorGroup.add(scoop);
        }

        const mirror = createSmoothRoundedBox(0.32, 0.2, 0.24, 0.08, accentMat);
        mirror.position.set(side * 0.22, 0.36, 0.55);
        doorGroup.add(mirror);

        doorGroup.position.set(side * width * 0.47, chassisY + 0.66, cabinZ);
        registerPart(doorGroup, 'door', 2, { radius: 0.55 });
      });

      const glassProfile = isLambo
        ? [[-1.3, 0], [1.25, 0], [0.45, 0.66], [-0.85, 0.66]]
        : isSports
        ? [[-1.1, 0], [1.1, 0], [0.55, 0.76], [-0.75, 0.76]]
        : isBus
        ? [[-cabinL * 0.48, 0], [cabinL * 0.48, 0], [cabinL * 0.44, 1.05], [-cabinL * 0.46, 1.05]]
        : [[-1.05, 0], [1.1, 0], [0.68, 0.92], [-0.88, 0.92]];
      const greenhouse = createSculptedProfileMesh(glassProfile, width * 0.86, 0.14, glassMat);
      greenhouse.position.set(0, chassisY + (isLambo ? 1.02 : 1.15), cabinZ);
      registerPart(greenhouse, 'glass', 1, { radius: 0.65 });

      const roof = createSmoothRoundedBox(width * 0.84, 0.22, cabinL * 0.76, 0.1, isBus ? accentMat : mainMat);
      roof.position.set(0, chassisY + cabinH + 0.34, cabinZ - 0.08);
      registerPart(roof, 'roof', 2, { radius: 0.65 });

      // 8. VEHICLE-SPECIFIC UNIQUE PARTS & CARGO
      if (isSports) {
        const rearDeck = createSculptedProfileMesh(
          [[-1.35, 0], [0.45, 0], [0.22, 0.65], [-1.3, 0.42]],
          width * 0.94,
          0.16,
          mainMat
        );
        rearDeck.position.set(0, chassisY + 0.7, -length * 0.28);
        registerPart(rearDeck, 'special', 2);

        const wingGroup = new THREE.Group();
        const wingBlade = createSmoothRoundedBox(width * 1.16, 0.14, 0.66, 0.05, isLambo ? darkMat : accentMat);
        wingGroup.add(wingBlade);
        [-0.68, 0.68].forEach((wx) => {
          const strut = createSmoothRoundedBox(0.1, 0.46, 0.34, 0.03, accentMat);
          strut.position.set(wx, -0.22, 0);
          wingGroup.add(strut);
        });
        wingGroup.position.set(0, chassisY + 1.45, -length * 0.44);
        gimmickPart = registerPart(wingGroup, 'special', 1);

        [-0.62, 0.62].forEach((tx) => {
          const turboFan = createCoolingFanMesh(0.5, 0xfacc15);
          turboFan.position.set(tx, chassisY + 0.95, -length * 0.35);
          registerPart(turboFan, 'fan', 2, { alwaysSpin: true });
          spinningFans.push(turboFan);
        });
      }

      if (spec.id === 'police') {
        const lowerBlack = createSmoothRoundedBox(width * 0.98, 0.68, length * 0.92, 0.16, accentMat);
        lowerBlack.position.set(0, chassisY + 0.46, 0);
        registerPart(lowerBlack, 'special', 3);

        const sirenGroup = new THREE.Group();
        const redDome = createSmoothRoundedBox(
          1.55,
          0.3,
          0.44,
          0.1,
          new THREE.MeshPhysicalMaterial({ color: 0xd90429, emissive: 0xdc2626, emissiveIntensity: 0.85 })
        );
        sirenGroup.add(redDome);
        sirenGroup.position.set(0, chassisY + cabinH + 0.62, cabinZ);
        gimmickPart = registerPart(sirenGroup, 'special', 1, { alwaysSpin: true });
        spinningFans.push(sirenGroup);

        for (let i = 0; i < 10; i++) {
          const cone = new THREE.Mesh(
            new THREE.ConeGeometry(0.34, 0.8, 16),
            createCarPaintMaterial(0xea580c, 0.1, 0.25)
          );
          cone.position.set(((i % 3) - 1) * 0.65, chassisY + 0.65, -0.9 - Math.floor(i / 3) * 0.52);
          registerPart(cone, 'cargo', 2, { restitution: 0.74, rollOnGround: true });
        }
      }

      if (spec.id === 'ambulance') {
        const boxBody = createSmoothRoundedBox(width * 0.98, 1.9, 3.2, 0.22, mainMat);
        boxBody.position.set(0, chassisY + 1.08, -0.78);
        registerPart(boxBody, 'special', 3, { radius: 0.95 });

        const redStripe = createSmoothRoundedBox(width * 1.02, 0.36, 3.24, 0.08, accentMat);
        redStripe.position.set(0, chassisY + 0.95, -0.78);
        registerPart(redStripe, 'special', 2);

        const siren = createSmoothRoundedBox(
          1.4,
          0.34,
          0.45,
          0.12,
