          new THREE.PlaneGeometry(50, 1.2),
          new THREE.MeshBasicMaterial({ color: dist % 100 === 0 ? 0xfacc15 : 0x94a3b8, side: THREE.DoubleSide })
        );
        line.rotation.x = -Math.PI / 2;
        line.position.set(0, 0.1, RAMP_END_Z + dist);
        worldGroup.add(line);
      }

      const rampWidth = 15.0;
      const steps = 120;
      for (let i = 0; i < steps; i++) {
        const z1 = (i / steps) * RAMP_END_Z;
        const z2 = ((i + 1) / steps) * RAMP_END_Z;
        const zMid = (z1 + z2) * 0.5;
        const y1 = getRampHeight(z1);
        const y2 = getRampHeight(z2);
        const yMid = (y1 + y2) * 0.5;
        const segLen = Math.hypot(z2 - z1, y2 - y1) + 0.2;
        const pitch = Math.atan2(y2 - y1, z2 - z1);

        const isTakeoffZone = zMid >= TAKEOFF_ZONE_START_Z;
        const segColor = isTakeoffZone
          ? (i % 2 === 0 ? 0x1e293b : 0x0f172a)
          : (i % 2 === 0 ? 0x18181b : 0x232329);

        const seg = new THREE.Mesh(
          new THREE.BoxGeometry(rampWidth, 1.4, segLen),
          new THREE.MeshStandardMaterial({ color: segColor, roughness: 0.78 })
        );
        seg.position.set(0, yMid - 0.7, zMid);
        seg.rotation.x = -pitch;
        seg.receiveShadow = true;
        seg.castShadow = true;
        worldGroup.add(seg);

        if (i % 2 === 0) {
          const centerStripe = new THREE.Mesh(
            new THREE.BoxGeometry(isTakeoffZone ? 1.4 : 0.45, 0.08, segLen * 0.75),
            new THREE.MeshBasicMaterial({ color: isTakeoffZone ? 0xf97316 : 0xfacc15 })
          );
          centerStripe.position.set(0, yMid + 0.03, zMid);
          centerStripe.rotation.x = -pitch;
          worldGroup.add(centerStripe);
        }

        [-rampWidth * 0.52, rampWidth * 0.52].forEach((rx) => {
