    // Realistic Forward-Momentum Part Detachment!
    // Detached parts inherit the car's forward velocity (`carVel.z * 0.78`) and rotational inertia
    // instead of popping outward like a stationary firework!
    function detachVehicleParts(stageFilterFn, explosionCenter, powerMul = 1.0, charBlack = false) {
      if (!activeCar) return;
      activeCar.rootGroup.updateMatrixWorld(true);

      activeCar.parts.forEach((p) => {
        if (p.detached || p.partType === 'chassis') return;
        if (stageFilterFn && !stageFilterFn(p)) return;

        const worldPos = new THREE.Vector3();
        const worldQuat = new THREE.Quaternion();
        p.mesh.getWorldPosition(worldPos);
        p.mesh.getWorldQuaternion(worldQuat);

        activeCar.squashGroup.remove(p.mesh);
        p.mesh.position.copy(worldPos);
        p.mesh.quaternion.copy(worldQuat);
        scene.add(p.mesh);
        p.detached = true;
        detachedPartsCount++;

        if (charBlack && p.partType !== 'fan') {
          p.mesh.traverse((child) => {
            if (child.isMesh && child.material) {
              child.material = child.material.clone();
              child.material.color.setHex(0x18181b);
              child.material.roughness = 0.92;
            }
          });
        }

        const localOffset = worldPos.clone().sub(explosionCenter);
        if (localOffset.lengthSq() < 0.01) {
          localOffset.set((Math.random() - 0.5) * 2, 0.5, (Math.random() - 0.5) * 2);
        }
        const outwardDir = localOffset.clone().normalize();

        const lateralSpread = (6 + Math.random() * 11) * powerMul;
        const upPop = (6 + Math.random() * 11) * powerMul;
        const forwardCarry = Math.max(18, carVel.z * 0.78) + (Math.random() - 0.2) * 14 * powerMul;

        p.vel.set(
          carVel.x * 0.65 + outwardDir.x * lateralSpread + (Math.random() - 0.5) * 8,
          Math.abs(outwardDir.y) * upPop + 5 * powerMul,
          forwardCarry
        );

        if (p.partType === 'wheel') {
          p.vel.z = Math.max(p.vel.z, 26 + Math.random() * 18);
          p.vel.y = Math.max(p.vel.y, 8 + Math.random() * 8);
          p.angVel.set(22 + Math.random() * 12, (Math.random() - 0.5) * 3, 0);
        } else {
          p.angVel.set(
            carAngVel.x * 0.6 + (Math.random() - 0.5) * 12,
            carAngVel.y * 0.6 + (Math.random() - 0.5) * 12,
            carAngVel.z * 0.6 + (Math.random() - 0.5) * 12
          );
        }
      });
    }

    // Master Realistic 6-Mode Crash Trigger (ゴロゴロ tumble is now ~68% default probability!)
    function triggerCrash(forcedMode = null) {
      if (!activeCar) return;
      currentState = STATE.CRASHED;
      crashTimer = 0;
      slowMoFactor = 0.34;
      screenShake = 1.25;
      tumbleBounceCount = 1;
      scatterStage = 1;
      squashProgress = 0;

      const targetZ = RAMP_END_Z + selectedCourseDist;
      const zFromTarget = carPos.z - targetZ;

      let mode = forcedMode;
      if (!mode) {
        if (Math.abs(zFromTarget - 68) < 28) {
          mode = 'water';
        } else if (Math.abs(zFromTarget + 52) < 20) {
          mode = 'explode';
        } else if (Math.random() < 0.68) {
          // 68% chance of realistic ゴロゴロ大回転バラバラクラッシュ (tumble)!
          mode = 'tumble';
        } else if (Math.abs(carPitch) > 0.75) {
          mode = 'squash';
        } else {
          mode = 'scatter';
        }
      }

      activeCrashMode = mode;
      sound.playCrash(mode);

      document.getElementById('hud-controls').classList.add('hidden');
      document.getElementById('crash-mode-badge').textContent = CRASH_NAMES[mode];
      document.getElementById('crash-mode-badge').classList.remove('hidden');
      document.getElementById('crash-focus-bar').classList.remove('hidden');

      showBanner(CRASH_NAMES[mode], 2200);

      // Preserve forward momentum in ALL crash modes so the car never stops unnaturally!
      const forwardSpeed = Math.max(30, carVel.z * 0.82);

      if (mode === 'tumble') {
        // ① ゴロゴロ大回転: Heavy forward barrel-roll & pitch tumble, shedding parts on every bounce!
        triggerFlash('bg-sky-300');
        spawnComicPopup('ゴロゴロ大回転！！🌪️', 'text-sky-300', 50, 38);
        carVel.set((Math.random() - 0.5) * 8, 16.5, forwardSpeed);
        carAngVel.set(-8.5, (Math.random() - 0.5) * 4.5, (Math.random() > 0.5 ? 1 : -1) * 7.2);
        spawnParticles(carPos, 32, 'sparks');
        detachVehicleParts((p) => p.releaseStage === 1, carPos, 0.95, false);
      } else if (mode === 'scatter') {
        // ② 高速スリップ大分解: High-speed forward skid tearing parts off progressively from front to back!
        triggerFlash('bg-orange-400');
        spawnComicPopup('ガシャーーーン！！💥', 'text-yellow-300', 50, 38);
        carVel.set((Math.random() - 0.5) * 6, 11.5, forwardSpeed * 1.05);
        carAngVel.set(-4.5, (Math.random() - 0.5) * 6.5, (Math.random() - 0.5) * 5.5);
        spawnParticles(carPos, 45, 'sparks');
        spawnParticles(carPos, 18, 'smoke');
        detachVehicleParts((p) => p.releaseStage === 1, carPos, 1.1, false);
      } else if (mode === 'squash') {
        // ③ フロント激突・前転: Front nose crumples on impact while rear kicks over into a forward flip!
        triggerFlash('bg-yellow-300');
        spawnComicPopup('グシャッ！！前転クラッシュ！💥', 'text-amber-300', 50, 38);
        squashProgress = 0.01;
        carVel.set((Math.random() - 0.5) * 6, 18.0, forwardSpeed * 0.78);
        carAngVel.set(-10.5, (Math.random() - 0.5) * 3.0, (Math.random() - 0.5) * 3.5);
        spawnParticles(carPos, 42, 'sparks');
        detachVehicleParts((p) => p.releaseStage <= 2, carPos, 1.15, false);
      } else if (mode === 'explode') {
        // ④ 大爆発＆黒焦げ横転: Blast launches blackened frame into a high tumbling arc trailing smoke & fire!
        triggerFlash('bg-rose-500');
        spawnComicPopup('ドッカーーーン！！🔥', 'text-rose-400', 50, 36);
        spawnParticles(carPos, 75, 'fire');
        spawnParticles(carPos, 45, 'smoke');
        carVel.set((Math.random() - 0.5) * 12, 24.0, forwardSpeed * 0.85);
        carAngVel.set(-9.0, 5.5, 8.0);
        detachVehicleParts((p) => p.releaseStage <= 2, carPos.clone().add(new THREE.Vector3(0, -1.2, 0)), 1.4, true);
      } else if (mode === 'pinball') {
        // ⑤ 高速きりもみスピン: Violent flat-spin + barrel roll across the asphalt flinging parts by centrifugal force!
        triggerFlash('bg-fuchsia-400');
        spawnComicPopup('ギュルルルッ！！大スピン！🌪️', 'text-fuchsia-300', 50, 38);
        spawnParticles(carPos, 45, 'sparks');
        carVel.set((Math.random() > 0.5 ? 1 : -1) * 16, 14.0, forwardSpeed * 0.9);
        carAngVel.set(-4.0, 16.5, 6.5);
        detachVehicleParts((p) => p.releaseStage <= 2, carPos, 1.25, false);
      } else if (mode === 'water') {
        // ⑥ 水面スキップ・水没: Skips across the pool surface throwing water spray and shedding floating parts!
        triggerFlash('bg-cyan-300');
        spawnComicPopup('バシャーーーン！！💦', 'text-cyan-300', 50, 38);
        const poolPos = new THREE.Vector3(carPos.x, 0.8, RAMP_END_Z + selectedCourseDist + 56);
        carPos.copy(poolPos);
        carVel.set(0, 9.5, 18.0);
        carAngVel.set(-3.5, 2.0, 3.0);
        activeCar.rootGroup.position.copy(carPos);
        spawnParticles(poolPos, 80, 'water');
        detachVehicleParts(() => true, poolPos, 1.0, false);
      }

      setTimeout(() => {
        if (currentState === STATE.CRASHED) {
          showResultCard(false);
        }
      }, 1850);
    }

    function showResultCard(isSuccess, landingScore = 0, distMeters = 0) {
      const card = document.getElementById('screen-result');
      const emoji = document.getElementById('result-emoji');
      const badge = document.getElementById('result-badge');
      const title = document.getElementById('result-title');
      const detail = document.getElementById('result-detail');

      if (isSuccess) {
        updateHighScoreDisplay(landingScore);
        emoji.textContent = landingScore === 100 ? '👑' : '🎉';
        badge.textContent = landingScore === 100 ? '🌟 どまんなか 100てん！ 🌟' : '✨ ちゃくち せいこう！ ✨';
        badge.className = 'inline-block text-xs font-black px-2.5 py-0.5 rounded-full bg-emerald-400 text-slate-950 mb-0.5';
        title.textContent = landingScore === 100 ? 'すごすぎる！ピタッと神ちゃくち！' : 'やったね！きれいに ちゃくち！';
        detail.textContent = `とんだ きょり：${distMeters}m（ひこう ${flightElapsed.toFixed(1)}びょう）／ ${landingScore}てん`;
      } else {
        const flyDist = Math.max(18, Math.round(maxWheelFlyDist));
        const crashPowerScore = Math.min(99, detachedPartsCount * 3 + Math.round(flyDist * 0.45));
        updateHighScoreDisplay(crashPowerScore);
        emoji.textContent = '💥';
        badge.textContent = CRASH_NAMES[activeCrashMode || 'tumble'];
        badge.className = 'inline-block text-xs font-black px-2.5 py-0.5 rounded-full bg-rose-500 text-white mb-0.5';
        title.textContent = 'ドッカーン！ドはでな だいクラッシュ！';
        detail.textContent = `ぶっとびパーツ：${detachedPartsCount}こ ／ タイヤ転がり：${flyDist}m（ぶっとび点：${crashPowerScore}てん）🛞`;
      }

      card.classList.remove('hidden');
    }

    // =========================================================================
    // 9. GAME FLOW CONTROLLERS
    // =========================================================================
    function startGameRun() {
      sound.init();
      document.getElementById('screen-title').classList.add('hidden');
      document.getElementById('screen-result').classList.add('hidden');
      document.getElementById('screen-pause').classList.add('hidden');
      document.getElementById('screen-crash-picker').classList.add('hidden');
      document.getElementById('crash-mode-badge').classList.add('hidden');
      document.getElementById('crash-focus-bar').classList.add('hidden');

      document.getElementById('hud-controls').classList.remove('hidden');
      document.getElementById('controls-run').classList.remove('hidden');
      document.getElementById('controls-flight').classList.add('hidden');
      document.getElementById('gauge-label').textContent = '🔥 スピード';

      currentState = STATE.RUN;
      if (camDist < 15) camDist = 17.5;
      if (Math.abs(camYaw) > 1.2) camYaw = 0.42;

      spawnSelectedVehicle();
      showBanner('🔥 ボタンを ながおし して ゴー！', 1600);
    }

    function executeJump(isPerfectRelease) {
      if (currentState !== STATE.RUN) return;
      currentState = STATE.FLIGHT;
      isAccelerating = false;
      flightElapsed = 0;

      carPos.z = Math.max(carPos.z, RAMP_END_Z);
      carPos.y = getRampHeight(RAMP_END_Z) + 0.5;

      document.getElementById('controls-run').classList.add('hidden');
      document.getElementById('controls-flight').classList.remove('hidden');

      const spec = VEHICLES[selectedCarIndex];
      const launchPitch = getRampPitchAngle(RAMP_END_Z);
      const speedRatio = Math.max(0.58, carSpeed / spec.maxSpeed);

      const vy0 = (28.5 + speedRatio * 3.2 + (isPerfectRelease ? 2.2 : 0)) * Math.sqrt(spec.gravityMul);
      const estFlightTime = 10.0;
      const targetReachZ = selectedCourseDist * (0.72 + speedRatio * 0.32) * (isPerfectRelease ? 1.04 : 0.94);
      const vz0 = targetReachZ / estFlightTime;

      carVel.set(0, vy0, vz0);
      carPitch = launchPitch;

      activeCar.rootGroup.position.copy(carPos);
      activeCar.rootGroup.rotation.set(-carPitch, 0, 0);

      sound.playJump(isPerfectRelease);
      spawnParticles(carPos, isPerfectRelease ? 30 : 16, isPerfectRelease ? 'confetti' : 'sparks');
      spawnComicPopup(isPerfectRelease ? 'ナイスジャンプ！！🚀' : 'ジャーーンプ！！✨', 'text-yellow-300', 50, 35);
      showBanner(isPerfectRelease ? '🌟 ナイスジャンプ！10びょう大飛行！ 🌟' : '🚀 だいジャンプ！', 1400);
    }

    function executeAirBoost() {
      if (currentState !== STATE.FLIGHT || airBoostCount >= 3) return;
      airBoostCount++;
      sound.playBoost();

      const spec = VEHICLES[selectedCarIndex];
      carVel.y += 4.6;
      carVel.z += 5.6;
      gimmickAnimTimer = 1.2;

      const left = 3 - airBoostCount;
      document.getElementById('boost-label').textContent =
        left > 0 ? `${spec.boostLabel} (あと${left}かい)` : '✨ ブースト まんたん！';

      const pType = spec.id === 'firetruck' ? 'water' : spec.id === 'garbage' || spec.id === 'keitruck' ? 'confetti' : 'fire';
      spawnParticles(carPos, 28, pType);
      spawnComicPopup(spec.boostLabel, 'text-amber-300', 50, 40);
      showBanner(spec.boostLabel, 1100);
    }

    // =========================================================================
    // 10. MAIN PHYSICS & ANIMATION LOOP (Unified Realistic Crash Tumble & Skid!)
    // =========================================================================
    let lastTime = performance.now();
    let animFrameId = null;

    function updateGame(rawDt) {
      const targetSlowMo = forceSlowMo ? 0.25 : 1.0;
      if (slowMoFactor < targetSlowMo) {
        slowMoFactor = Math.min(targetSlowMo, slowMoFactor + rawDt * 0.35);
      } else if (forceSlowMo) {
        slowMoFactor = 0.25;
      }

      const dt = Math.min(rawDt, 0.05) * slowMoFactor;
      const spec = VEHICLES[selectedCarIndex];

      if (screenShake > 0) {
        screenShake = Math.max(0, screenShake - rawDt * 3.0);
      }

      envWindmills.forEach((w) => {
        w.rotation.z += rawDt * 4.5;
      });
      if (activeCar) {
        const fanSpeedMul = gimmickAnimTimer > 0 ? 2.4 : 1.0;
        activeCar.spinningFans.forEach((fan) => {
          fan.rotation.z += rawDt * 24 * fanSpeedMul;
        });

        if (gimmickAnimTimer > 0) {
          gimmickAnimTimer = Math.max(0, gimmickAnimTimer - rawDt);
          if (activeCar.gimmickPart && !activeCar.gimmickPart.detached) {
            if (spec.id === 'dumptruck') {
              activeCar.gimmickPart.rotation.x = -Math.sin(gimmickAnimTimer * Math.PI) * 0.55;
            } else if (spec.id === 'excavator') {
              activeCar.gimmickPart.rotation.x = 0.45 + Math.sin(gimmickAnimTimer * 10) * 0.45;
            } else if (spec.id === 'firetruck') {
              activeCar.gimmickPart.position.z = -0.35 + Math.sin(gimmickAnimTimer * Math.PI) * 1.6;
            }
          }
        }
      }

      updateParticles(dt);

      if (shadowIndicator && activeCar) {
        shadowIndicator.position.set(carPos.x, 0.25, carPos.z);
      }

      // STATE: TITLE
      if (currentState === STATE.TITLE) {
        if (activeCar) {
          activeCar.rootGroup.rotation.set(0, 0, 0);
          activeCar.wheels.forEach((w) => {
            w.rotation.x += rawDt * 4.5;
          });
          updateCameraFollow(rawDt);
        }
        return;
      }

      // STATE: RUN
      if (currentState === STATE.RUN) {
        if (isAccelerating || jumpQueuedPerfect) {
          carSpeed = Math.min(spec.maxSpeed, carSpeed + spec.accel * rawDt);
          sound.startEngine();
          if (Math.random() > 0.65) {
            spawnParticles(carPos.clone().add(new THREE.Vector3(0, 0.35, -3.2)), 1, 'fire');
          }
        } else {
          if (carPos.z > 15) {
            carSpeed = Math.min(spec.maxSpeed * 0.68, carSpeed + 8.5 * rawDt);
          } else {
            carSpeed = Math.max(0, carSpeed - 12 * rawDt);
          }
        }

        sound.updateEngine(carSpeed / spec.maxSpeed, spec.id, rawDt);

        carPos.z = Math.min(RAMP_END_Z, carPos.z + carSpeed * dt);
        carPos.y = getRampHeight(carPos.z);
        carPitch = getRampPitchAngle(carPos.z);

        activeCar.rootGroup.position.copy(carPos);
        activeCar.rootGroup.rotation.set(-carPitch, 0, 0);
        activeCar.wheels.forEach((w) => {
          w.rotation.x += carSpeed * dt * 0.85;
        });

        const pct = Math.min(100, Math.round((carSpeed / spec.maxSpeed) * 100));
        document.getElementById('speed-bar').style.width = `${pct}%`;
        const remainMeters = Math.max(0, Math.round(RAMP_END_Z - carPos.z));
        document.getElementById('speed-readout').textContent = `${Math.round(carSpeed * 2.6)}km/h (あと${remainMeters}m)`;

        if (carPos.z >= TAKEOFF_ZONE_START_Z) {
          document.getElementById('btn-accelerate-label').textContent = jumpQueuedPerfect
            ? '🌟 ナイスタイミング！ そのまま ジャンプ！ 🌟'
            : '✨ いまだ！ てを はなして ジャンプ！ ✨';
        } else {
          document.getElementById('btn-accelerate-label').textContent = '🔥 ながおし で ゴー！（ジャンプゾーンで はなす）';
        }

        if (carPos.z >= RAMP_END_Z) {
          executeJump(jumpQueuedPerfect);
        }

        updateCameraFollow(rawDt);
        return;
      }

      // STATE: FLIGHT
      if (currentState === STATE.FLIGHT) {
        flightElapsed += dt;
        const flightGravity = 6.8 * spec.gravityMul;
        carVel.y -= flightGravity * dt;

        if (pitchInput !== 0) {
          carPitch += pitchInput * spec.pitchSpeed * dt;
          carVel.z += pitchInput * 11.0 * dt;
        }

        carPos.addScaledVector(carVel, dt);

        activeCar.rootGroup.position.copy(carPos);
        activeCar.rootGroup.rotation.set(-carPitch, 0, carRoll);
        activeCar.wheels.forEach((w) => {
          w.rotation.x += 10 * dt;
        });

        const distNow = Math.max(0, Math.round(carPos.z - RAMP_END_Z));
        document.getElementById('gauge-label').textContent = `✈️ ひこう ${flightElapsed.toFixed(1)}びょう`;
        document.getElementById('speed-readout').textContent = `${distNow}m / ${selectedCourseDist}m`;
        document.getElementById('speed-bar').style.width = `${Math.min(100, (distNow / selectedCourseDist) * 100)}%`;

        updateCameraFollow(rawDt);

        if (carPos.y <= activeCar.wheelRadius + 0.15) {
          carPos.y = activeCar.wheelRadius;
          activeCar.rootGroup.position.copy(carPos);

          const targetZ = RAMP_END_Z + selectedCourseDist;
          const distError = Math.abs(carPos.z - targetZ);
          const pitchDeg = Math.abs((carPitch * 180) / Math.PI) % 360;
          const normalizedPitchError = Math.min(pitchDeg, Math.abs(360 - pitchDeg));

          if (distError <= 25 && normalizedPitchError <= 28) {
            currentState = STATE.LANDED;
            sound.playSuccessFanfare();
            document.getElementById('hud-controls').classList.add('hidden');
            carPitch = 0;
            activeCar.rootGroup.rotation.set(0, 0, 0);
            spawnParticles(carPos, 85, 'confetti');

            const score = distError <= 6.5 ? 100 : distError <= 15 ? 80 : 60;
            spawnComicPopup(score === 100 ? '100てん！ピタッ！👑' : 'ちゃくち成功！🎉', 'text-emerald-300', 50, 36);
            showBanner(score === 100 ? '👑 どまんなか！100てん！！' : '🎉 ちゃくち だいせいこう！！', 2200);
            setTimeout(() => {
              showResultCard(true, score, distNow);
            }, 900);
          } else {
            triggerCrash(null);
          }
        }
        return;
      }

      // STATE: LANDED
      if (currentState === STATE.LANDED) {
        updateCameraFollow(rawDt);
        return;
      }

      // STATE: CRASHED (Realistic Momentum Tumble, Crumple & Progressive Part Shedding in ALL Modes!)
      if (currentState === STATE.CRASHED) {
        crashTimer += rawDt;

        // Progressive front-to-back part tearing for `scatter` mode during high-speed skid
        if (activeCrashMode === 'scatter') {
          if (crashTimer > 0.12 && scatterStage === 1) {
            scatterStage = 2;
            detachVehicleParts((p) => p.releaseStage === 2, carPos, 1.15, false);
            spawnParticles(carPos, 25, 'sparks');
          } else if (crashTimer > 0.26 && scatterStage === 2) {
            scatterStage = 3;
            detachVehicleParts((p) => p.releaseStage >= 3, carPos, 1.25, false);
            spawnParticles(carPos, 25, 'smoke');
          }
        }

        // Realistic Nose-Dive Crumple deformation for `squash` mode (compresses length & height, not cartoon pancake!)
        if (activeCrashMode === 'squash' && squashProgress > 0 && squashProgress < 1) {
          squashProgress = Math.min(1, squashProgress + rawDt * 4.2);
          const sy = 1 - squashProgress * 0.34;
          const sz = 1 - squashProgress * 0.38;
          const sx = 1 + squashProgress * 0.18;
          activeCar.squashGroup.scale.set(sx, sy, sz);
        }

        // Simulate the Car's Core Chassis/Body Tumbling, Bouncing & Skidding Forward in ALL Modes!
        if (activeCrashMode === 'water' && carPos.y <= 0.9 && carVel.y <= 0) {
          // Floating & bobbing in the water pool
          carPos.y = 0.65 + Math.sin(crashTimer * 3.5) * 0.18;
          carVel.multiplyScalar(0.92);
          carAngVel.multiplyScalar(0.9);
          activeCar.rootGroup.position.copy(carPos);
        } else {
          carVel.y -= 28 * dt;
          carPos.addScaledVector(carVel, dt);
          // Clamp within stadium bounds
          carPos.x = Math.max(-180, Math.min(180, carPos.x));
          activeCar.rootGroup.position.copy(carPos);

          activeCar.rootGroup.rotation.x += carAngVel.x * dt;
          activeCar.rootGroup.rotation.y += carAngVel.y * dt;
          activeCar.rootGroup.rotation.z += carAngVel.z * dt;

          // Ground Impact & Bounce for the Tumbling Car Body
          if (carPos.y <= activeCar.wheelRadius * 0.85) {
            carPos.y = activeCar.wheelRadius * 0.85;
            if (Math.abs(carVel.y) > 3.2) {
              const bounceRestitution = activeCrashMode === 'tumble' ? 0.65 : activeCrashMode === 'pinball' ? 0.72 : 0.52;
              carVel.y = Math.abs(carVel.y) * bounceRestitution;
              carVel.z *= 0.82;
              carVel.x *= 0.85;
              carAngVel.multiplyScalar(0.84);
              screenShake = Math.min(1.0, screenShake + 0.45);

              sound.playPartBounce(false);
              spawnParticles(carPos, 18, 'sparks');
              if (activeCrashMode === 'explode' || Math.random() > 0.5) {
                spawnParticles(carPos, 8, 'smoke');
              }

              // Shed next stage of parts on every ground impact!
              if (tumbleBounceCount < 4) {
                tumbleBounceCount++;
                const isCharred = activeCrashMode === 'explode';
                if (tumbleBounceCount >= 3) {
                  detachVehicleParts(() => true, carPos, 1.15, isCharred);
                } else {
                  detachVehicleParts((p) => p.releaseStage <= tumbleBounceCount, carPos, 1.05, isCharred);
                }
              }
            } else {
              // Skidding to a halt on the asphalt
              carVel.y = 0;
              carVel.x *= 0.88;
              carVel.z *= 0.91;
              carAngVel.multiplyScalar(0.82);
              if (carVel.lengthSq() > 12 && Math.random() > 0.5) {
                spawnParticles(carPos, 2, 'sparks');
              }
            }
          }
        }

        // Simulate Every Detached 3D Part with Realistic Momentum, Bouncing & Asphalt Friction
        activeCar.parts.forEach((p) => {
          if (!p.detached) return;

          if (activeCrashMode === 'water' && p.mesh.position.y <= 0.65 && p.vel.y <= 0) {
            p.mesh.position.y = 0.45 + Math.sin(crashTimer * 4 + p.origPos.x * 2) * 0.18;
            p.vel.multiplyScalar(0.93);
            p.mesh.rotation.y += dt * 1.4;
            return;
          }

          p.vel.y -= 28 * dt;
          p.mesh.position.addScaledVector(p.vel, dt);

          if (p.alwaysSpin) {
            p.mesh.rotation.z += rawDt * 25;
          } else {
            p.mesh.rotation.x += p.angVel.x * dt;
            p.mesh.rotation.y += p.angVel.y * dt;
            p.mesh.rotation.z += p.angVel.z * dt;
          }

          if (p.mesh.position.y < p.radius) {
            p.mesh.position.y = p.radius;
            if (Math.abs(p.vel.y) > 2.4) {
              p.vel.y = Math.abs(p.vel.y) * p.restitution;
              sound.playPartBounce(p.partType === 'wheel');
              if (p.partType !== 'wheel' && p.partType !== 'cargo' && Math.random() > 0.65) {
                spawnParticles(p.mesh.position, 2, 'sparks');
              }
            } else {
              p.vel.y = 0;
            }

            if (p.rollOnGround) {
              p.vel.x *= 0.985;
              p.vel.z *= 0.986;
              p.mesh.rotation.x += p.vel.z * dt * 1.35;
            } else {
              p.vel.x *= 0.85;
              p.vel.z *= 0.86;
              p.angVel.multiplyScalar(0.84);
            }
          }

          if (p.partType === 'wheel') {
            const dFromCar = p.mesh.position.distanceTo(carPos);
            if (dFromCar > maxWheelFlyDist) maxWheelFlyDist = dFromCar;
          }
        });

        updateCameraFollow(rawDt);
      }
    }

    function animate(now) {
      animFrameId = requestAnimationFrame(animate);
      const rawDt = (now - lastTime) / 1000;
      lastTime = now;

      if (currentState !== STATE.PAUSED) {
        updateGame(rawDt);
      }
      renderer.render(scene, camera);
    }

    // =========================================================================
    // 11. UI INITIALIZATION & EVENT LISTENERS
    // =========================================================================
    function renderVehicleSelectionGrid() {
      const grid = document.getElementById('car-grid');
      grid.innerHTML = '';
      VEHICLES.forEach((v, idx) => {
        const isSelected = idx === selectedCarIndex;
        const btn = document.createElement('button');
        btn.type = 'button';
        btn.className = `toy-btn p-1.5 rounded-2xl flex flex-col items-center justify-center text-center border-2 ${
          isSelected
            ? 'bg-gradient-to-b from-amber-400 to-orange-500 text-slate-950 border-white shadow-lg scale-105'
            : 'bg-slate-800/90 hover:bg-slate-700 text-white border-white/20'
        }`;
        btn.innerHTML = `
          <div class="text-xl sm:text-2xl">${v.icon}</div>
          <div class="font-black text-[10px] sm:text-xs leading-tight">${v.name}</div>
        `;
        btn.addEventListener('click', () => {
          selectedCarIndex = idx;
          sound.playTone(540, 0.12, 'triangle', 0.12, 760);
          renderVehicleSelectionGrid();
          spawnSelectedVehicle();
        });
        grid.appendChild(btn);
      });
    }

    function setupEventListeners() {
      document.getElementById('cam-preset-back').addEventListener('click', () => setCameraPreset('back'));
      document.getElementById('cam-preset-diag').addEventListener('click', () => setCameraPreset('diag'));
      document.getElementById('cam-preset-side').addEventListener('click', () => setCameraPreset('side'));
      document.getElementById('cam-preset-front').addEventListener('click', () => setCameraPreset('front'));
      document.getElementById('cam-preset-closeup').addEventListener('click', () => setCameraPreset('closeup'));
      document.getElementById('cam-zoom-out').addEventListener('click', () => {
        camDist = Math.min(28.0, camDist + 3.2);
      });

      document.getElementById('cam-rot-left').addEventListener('click', () => { camYaw -= 0.35; });
      document.getElementById('cam-rot-right').addEventListener('click', () => { camYaw += 0.35; });
      document.getElementById('cam-rot-up').addEventListener('click', () => {
        camElevation = Math.min(1.15, camElevation + 0.14);
      });
      document.getElementById('cam-rot-down').addEventListener('click', () => {
        camElevation = Math.max(0.08, camElevation - 0.14);
      });

      // Phase 3 Crash Camera Target Switcher (Follow Car Body vs Rolling Tire vs Spinning Fan!)
      document.querySelectorAll('.focus-btn').forEach((btn) => {
        btn.addEventListener('click', () => {
          crashCameraFocus = btn.getAttribute('data-focus');
          sound.playTone(620, 0.1, 'sine', 0.12, 880);
          document.querySelectorAll('.focus-btn').forEach((b) => {
            b.className = 'focus-btn toy-btn bg-slate-800 text-white font-black px-2 py-0.5 rounded-full';
          });
          btn.className = 'focus-btn toy-btn bg-amber-400 text-slate-950 font-black px-2 py-0.5 rounded-full';
        });
      });

      document.getElementById('btn-slowmo-toggle').addEventListener('click', () => {
        forceSlowMo = !forceSlowMo;
        slowMoFactor = forceSlowMo ? 0.25 : 1.0;
        const btn = document.getElementById('btn-slowmo-toggle');
        btn.textContent = forceSlowMo ? '🐢 スロー: ずっとON' : '🐢 スロー: じどう';
        btn.className = forceSlowMo
          ? 'toy-btn bg-amber-400 border-2 border-white text-slate-950 font-black px-2.5 py-1.5 rounded-2xl text-xs sm:text-sm shadow-lg'
          : 'toy-btn bg-purple-700 hover:bg-purple-600 border-2 border-purple-300 text-white font-black px-2.5 py-1.5 rounded-2xl text-xs sm:text-sm shadow-lg';
      });

      renderer.domElement.addEventListener('pointerdown', (e) => {
        isDraggingCamera = true;
        lastPointerX = e.clientX;
        lastPointerY = e.clientY;
      });
      window.addEventListener('pointermove', (e) => {
        if (isDraggingCamera) {
          const dx = e.clientX - lastPointerX;
          const dy = e.clientY - lastPointerY;
          lastPointerX = e.clientX;
          lastPointerY = e.clientY;
          camYaw += dx * 0.0085;
          camElevation = Math.max(0.06, Math.min(1.2, camElevation + dy * 0.006));
        }
      });
      window.addEventListener('pointerup', () => {
        isDraggingCamera = false;
      });
      renderer.domElement.addEventListener('wheel', (e) => {
        camDist = Math.max(7.5, Math.min(30.0, camDist + e.deltaY * 0.012));
      }, { passive: true });

      document.querySelectorAll('.dist-btn').forEach((btn) => {
        btn.addEventListener('click', () => {
          selectedCourseDist = Number(btn.getAttribute('data-dist'));
          sound.playTone(440, 0.12, 'sine', 0.12, 660);
          document.querySelectorAll('.dist-btn').forEach((b) => {
            b.classList.remove('border-4', 'border-yellow-300', 'bg-amber-500', 'text-slate-950');
            b.classList.add('border-2', 'border-white/30');
          });
          btn.classList.add('border-4', 'border-yellow-300');
          updateTargetZonePosition(selectedCourseDist);
          spawnSelectedVehicle();
        });
      });

      document.getElementById('btn-start-game').addEventListener('click', startGameRun);
      document.getElementById('btn-retry').addEventListener('click', startGameRun);
      document.getElementById('btn-change-car').addEventListener('click', () => {
        sound.stopEngine();
        currentState = STATE.TITLE;
        document.getElementById('screen-result').classList.add('hidden');
        document.getElementById('crash-mode-badge').classList.add('hidden');
        document.getElementById('crash-focus-bar').classList.add('hidden');
        document.getElementById('hud-controls').classList.add('hidden');
        document.getElementById('screen-title').classList.remove('hidden');
        spawnSelectedVehicle();
      });

      document.getElementById('btn-sound-toggle').addEventListener('click', () => {
        const on = sound.toggle();
        document.getElementById('btn-sound-toggle').textContent = on ? '🔊 おと ON' : '🔇 おと OFF';
      });

      document.getElementById('btn-pause').addEventListener('click', () => {
        if (currentState === STATE.PAUSED) {
          currentState = prevStateBeforePause;
          document.getElementById('screen-pause').classList.add('hidden');
        } else {
          prevStateBeforePause = currentState;
          currentState = STATE.PAUSED;
          sound.stopEngine();
          document.getElementById('screen-pause').classList.remove('hidden');
        }
      });
      document.getElementById('btn-resume').addEventListener('click', () => {
        currentState = prevStateBeforePause;
        document.getElementById('screen-pause').classList.add('hidden');
      });
      document.getElementById('btn-pause-retry').addEventListener('click', startGameRun);
      document.getElementById('btn-pause-title').addEventListener('click', () => {
        currentState = STATE.TITLE;
        document.getElementById('screen-pause').classList.add('hidden');
        document.getElementById('screen-result').classList.add('hidden');
        document.getElementById('crash-focus-bar').classList.add('hidden');
        document.getElementById('hud-controls').classList.add('hidden');
        document.getElementById('screen-title').classList.remove('hidden');
        spawnSelectedVehicle();
      });

      document.getElementById('btn-instant-crash').addEventListener('click', () => {
        document.getElementById('screen-crash-picker').classList.toggle('hidden');
      });
      document.getElementById('btn-close-crash-picker').addEventListener('click', () => {
        document.getElementById('screen-crash-picker').classList.add('hidden');
      });
      document.querySelectorAll('.crash-pick-btn').forEach((btn) => {
        btn.addEventListener('click', () => {
          const mode = btn.getAttribute('data-crash');
          document.getElementById('screen-crash-picker').classList.add('hidden');
          document.getElementById('screen-title').classList.add('hidden');
          document.getElementById('screen-result').classList.add('hidden');

          spawnSelectedVehicle();
          const targetZ = RAMP_END_Z + selectedCourseDist;
          carPos.set(0, activeCar.wheelRadius + 1.2, targetZ);
          carVel.set(0, -18, 42);
          activeCar.rootGroup.position.copy(carPos);
          activeCar.rootGroup.rotation.set(0, 0, 0);
          triggerCrash(mode);
        });
      });

      const accelBtn = document.getElementById('btn-accelerate');
      const startHold = (e) => {
        e.preventDefault();
        if (currentState === STATE.RUN) {
          isAccelerating = true;
          sound.startEngine();
        }
      };
      const endHold = (e) => {
        e.preventDefault();
        if (currentState === STATE.RUN && isAccelerating) {
          isAccelerating = false;
          if (carPos.z >= TAKEOFF_ZONE_START_Z - 35) {
            jumpQueuedPerfect = true;
            showBanner('🌟 ナイスタイミング！ 先端から大ジャンプ！ 🌟', 1200);
          }
        }
      };
      accelBtn.addEventListener('pointerdown', startHold);
      window.addEventListener('pointerup', endHold);

      const pitchDownBtn = document.getElementById('btn-pitch-down');
      const pitchUpBtn = document.getElementById('btn-pitch-up');
      pitchDownBtn.addEventListener('pointerdown', (e) => { e.preventDefault(); pitchInput = 1; });
      pitchDownBtn.addEventListener('pointerup', () => { pitchInput = 0; });
      pitchDownBtn.addEventListener('pointerleave', () => { pitchInput = 0; });

      pitchUpBtn.addEventListener('pointerdown', (e) => { e.preventDefault(); pitchInput = -1; });
      pitchUpBtn.addEventListener('pointerup', () => { pitchInput = 0; });
      pitchUpBtn.addEventListener('pointerleave', () => { pitchInput = 0; });

      document.getElementById('btn-air-boost').addEventListener('click', executeAirBoost);

      window.addEventListener('keydown', (e) => {
        if (e.code === 'Space' || e.code === 'ArrowUp' || e.code === 'KeyW') {
          if (currentState === STATE.RUN) {
            isAccelerating = true;
            sound.startEngine();
          } else if (currentState === STATE.FLIGHT && e.code === 'Space') {
            executeAirBoost();
          }
        }
        if (e.code === 'ArrowLeft' || e.code === 'KeyA') pitchInput = 1;
        if (e.code === 'ArrowRight' || e.code === 'KeyD') pitchInput = -1;
      });
      window.addEventListener('keyup', (e) => {
        if (e.code === 'Space' || e.code === 'ArrowUp' || e.code === 'KeyW') {
          if (currentState === STATE.RUN && isAccelerating) {
            isAccelerating = false;
            if (carPos.z >= TAKEOFF_ZONE_START_Z - 35) {
              jumpQueuedPerfect = true;
            }
          }
        }
        if (e.code === 'ArrowLeft' || e.code === 'KeyA' || e.code === 'ArrowRight' || e.code === 'KeyD') {
          pitchInput = 0;
        }
      });

      window.addEventListener('resize', () => {
        camera.aspect = window.innerWidth / window.innerHeight;
        camera.updateProjectionMatrix();
        renderer.setSize(window.innerWidth, window.innerHeight);
      });
    }

    window.addEventListener('load', () => {
      updateHighScoreDisplay(0);
      buildSkiJumpWorld();
      renderVehicleSelectionGrid();
      spawnSelectedVehicle();
      setupEventListeners();
      setCameraPreset('diag');
      if (animFrameId) cancelAnimationFrame(animFrameId);
      lastTime = performance.now();
      animFrameId = requestAnimationFrame(animate);
    });
  </script>
</body>
</html>
