    // =========================================================================
    // 3. MEGA SKI JUMP RAMP GEOMETRY (SAFE CLAMPED HEIGHT)
    // =========================================================================
    const RAMP_END_Z = 420;
    const TAKEOFF_ZONE_START_Z = 355;

    function getRampHeight(z) {
      const cz = Math.max(0, Math.min(RAMP_END_Z, z));
      if (cz <= 22) {
        return 175;
      } else if (cz <= 355) {
        const t = (cz - 22) / (355 - 22);
        return 175 - 151 * (0.5 - 0.5 * Math.cos(Math.PI * t));
      } else {
        const t = (cz - 355) / (RAMP_END_Z - 355);
        return 24 + 10.0 * (t * t);
      }
    }

    function getRampPitchAngle(z) {
      const cz = Math.max(1, Math.min(RAMP_END_Z - 1, z));
      const dz = 1.0;
      const y1 = getRampHeight(cz - dz);
      const y2 = getRampHeight(cz + dz);
      return Math.atan2(y2 - y1, dz * 2);
    }

    // =========================================================================
