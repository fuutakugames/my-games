    // 7. 3D PARTICLE SYSTEM
    // =========================================================================
    const particles = [];

    function spawnParticles(pos, count, preset) {
      for (let i = 0; i < count; i++) {
        let geo, color, size, speed, gravity, life;
        if (preset === 'fire') {
          size = 0.24 + Math.random() * 0.28;
          geo = new THREE.SphereGeometry(size, 8, 8);
          color = Math.random() > 0.4 ? 0xea580c : 0xfacc15;
          speed = 7 + Math.random() * 12;
          gravity = -10;
          life = 0.4 + Math.random() * 0.3;
        } else if (preset === 'smoke') {
          size = 0.65 + Math.random() * 0.9;
          geo = new THREE.SphereGeometry(size, 10, 10);
          color = 0x1e293b;
          speed = 5 + Math.random() * 10;
          gravity = 3.5;
          life = 1.0 + Math.random() * 0.7;
        } else if (preset === 'water') {
          size = 0.42 + Math.random() * 0.55;
          geo = new THREE.SphereGeometry(size, 10, 10);
          color = Math.random() > 0.35 ? 0x0284c7 : 0xf8fafc;
          speed = 15 + Math.random() * 22;
          gravity = -30;
          life = 0.95 + Math.random() * 0.5;
        } else if (preset === 'confetti') {
          geo = new THREE.BoxGeometry(0.52, 0.14, 0.52);
          const cols = [0xd90429, 0xfacc15, 0x16a34a, 0x0284c7, 0x9333ea];
          color = cols[i % cols.length];
          speed = 14 + Math.random() * 20;
          gravity = -14;
          life = 1.6 + Math.random() * 0.8;
        } else {
          size = 0.22 + Math.random() * 0.25;
          geo = new THREE.BoxGeometry(size, size, size);
          color = Math.random() > 0.5 ? 0xfacc15 : 0xea580c;
          speed = 9 + Math.random() * 20;
          gravity = -28;
          life = 0.55 + Math.random() * 0.45;
        }

        const mat = new THREE.MeshStandardMaterial({ color, roughness: 0.3 });
        const mesh = new THREE.Mesh(geo, mat);
        mesh.position.copy(pos);
        const angle = Math.random() * Math.PI * 2;
        const upBias = preset === 'water' || preset === 'confetti' ? 0.85 : 0.4;
        const vel = new THREE.Vector3(
          Math.cos(angle) * speed * (0.4 + Math.random() * 0.6),
          speed * (upBias + Math.random() * 0.5),
          Math.sin(angle) * speed * (0.4 + Math.random() * 0.6)
        );
        scene.add(mesh);
        particles.push({ mesh, vel, gravity, life, maxLife: life });
      }
    }

    function updateParticles(dt) {
      for (let i = particles.length - 1; i >= 0; i--) {
        const p = particles[i];
        p.life -= dt;
        if (p.life <= 0) {
          scene.remove(p.mesh);
          particles.splice(i, 1);
          continue;
        }
        p.vel.y += p.gravity * dt;
        p.mesh.position.addScaledVector(p.vel, dt);
        p.mesh.rotation.x += dt * 6;
        p.mesh.rotation.y += dt * 5;
        if (p.mesh.position.y < 0.2) {
          p.mesh.position.y = 0.2;
          p.vel.y *= -0.5;
          p.vel.x *= 0.82;
          p.vel.z *= 0.82;
        }
        const scale = Math.max(0.05, p.life / p.maxLife);
        p.mesh.scale.setScalar(scale);
      }
    }

    // =========================================================================
    // 8. GAME STATE, REALISTIC MOMENTUM CRASH ENGINE & PHASE 3 FOCUS CAMERA
    // =========================================================================
    const STATE = {
      TITLE: 'TITLE',
      RUN: 'RUN',
      FLIGHT: 'FLIGHT',
      LANDED: 'LANDED',
      CRASHED: 'CRASHED',
      PAUSED: 'PAUSED'
    };

    let currentState = STATE.TITLE;
    let prevStateBeforePause = STATE.TITLE;
    let selectedCarIndex = 0;
    let selectedCourseDist = 450;

    let activeCar = null;
    let carPos = new THREE.Vector3(0, 175, 10);
    let carVel = new THREE.Vector3(0, 0, 0);
    let carAngVel = new THREE.Vector3(0, 0, 0);
    let carPitch = 0;
    let carRoll = 0;
    let carSpeed = 0;
    let airBoostCount = 0;
    let flightElapsed = 0;
    let gimmickAnimTimer = 0;
    let jumpQueuedPerfect = false;

    let isAccelerating = false;
    let pitchInput = 0;

    let camYaw = 0.42;
    let camElevation = 0.34;
    let camDist = 17.5;
    let crashCameraFocus = 'chassis'; // 'chassis' | 'wheel' | 'fan'
    let isDraggingCamera = false;
    let lastPointerX = 0;
    let lastPointerY = 0;

    let activeCrashMode = null;
    let crashTimer = 0;
    let slowMoFactor = 1.0;
    let forceSlowMo = false;
    let screenShake = 0;
    let squashProgress = 0;
    let tumbleBounceCount = 0;
    let scatterStage = 0;
    let detachedPartsCount = 0;
    let maxWheelFlyDist = 0;

    function setCameraPreset(presetName) {
      document.querySelectorAll('.cam-preset-btn').forEach((b) => {
        b.className = 'cam-preset-btn toy-btn bg-slate-800 hover:bg-slate-700 text-white font-black px-2 py-1 rounded-xl text-xs border border-white/20';
      });
      const activeId = `cam-preset-${presetName}`;
      const activeBtn = document.getElementById(activeId);
      if (activeBtn) {
        activeBtn.className = 'cam-preset-btn toy-btn bg-sky-400 text-slate-950 font-black px-2 py-1 rounded-xl text-xs border-2 border-white shadow';
      }

      if (presetName === 'back') {
        camYaw = 0.0;
        camElevation = 0.34;
        camDist = 17.2;
      } else if (presetName === 'diag') {
        camYaw = 0.52;
        camElevation = 0.34;
        camDist = 17.5;
      } else if (presetName === 'side') {
        camYaw = Math.PI * 0.48;
        camElevation = 0.24;
        camDist = 20.5;
      } else if (presetName === 'front') {
        camYaw = Math.PI * 0.88;
        camElevation = 0.28;
        camDist = 17.0;
      } else if (presetName === 'closeup') {
        camYaw = 0.45;
        camElevation = 0.26;
        camDist = 11.2;
      }
    }

    function getCrashFocusPosition() {
      if (currentState === STATE.CRASHED && activeCar && crashCameraFocus !== 'chassis') {
        const candidate = activeCar.parts.find((p) => p.detached && p.partType === crashCameraFocus);
        if (candidate && candidate.mesh) {
          return candidate.mesh.position;
        }
      }
      return carPos;
    }

    function updateCameraFollow(rawDt) {
      if (!activeCar) return;

      if ((currentState === STATE.TITLE || currentState === STATE.CRASHED || currentState === STATE.LANDED) && !isDraggingCamera) {
        camYaw += rawDt * (currentState === STATE.TITLE ? 0.35 : 0.22);
      }

      const focusPos = getCrashFocusPosition();
      const horizDist = camDist * Math.cos(camElevation);
      const vertOffset = camDist * Math.sin(camElevation);

      const offsetX = Math.sin(camYaw) * horizDist;
      const offsetZ = -Math.cos(camYaw) * horizDist;

      const desiredX = focusPos.x + offsetX;
      const desiredZ = focusPos.z + offsetZ;
      let desiredY = focusPos.y + 2.6 + vertOffset;

      if (desiredZ >= 0 && desiredZ <= RAMP_END_Z + 12) {
        const rampFloorY = getRampHeight(desiredZ);
        desiredY = Math.max(desiredY, rampFloorY + 4.2);
      } else {
        desiredY = Math.max(desiredY, 3.2);
      }

      const shakeX = (Math.random() - 0.5) * screenShake;
      const shakeY = (Math.random() - 0.5) * screenShake;

      camera.position.set(desiredX + shakeX, desiredY + shakeY, desiredZ);

      const lookY = currentState === STATE.TITLE ? focusPos.y + 0.5 : focusPos.y + 1.25;
      const lookZ = currentState === STATE.RUN || currentState === STATE.FLIGHT ? focusPos.z + 2.2 : focusPos.z;
      camera.lookAt(focusPos.x, lookY, lookZ);

      carKeyLight.position.set(camera.position.x, camera.position.y + 6, camera.position.z);
    }

    function spawnSelectedVehicle() {
      if (activeCar) {
        scene.remove(activeCar.rootGroup);
        activeCar.parts.forEach((p) => {
          if (p.detached) scene.remove(p.mesh);
        });
      }
      const spec = VEHICLES[selectedCarIndex];
      activeCar = buildVehicle3D(spec);
      scene.add(activeCar.rootGroup);

      carPos.set(0, getRampHeight(10), 10);
      carVel.set(0, 0, 0);
      carAngVel.set(0, 0, 0);
      carPitch = getRampPitchAngle(10);
      carRoll = 0;
      carSpeed = 0;
      airBoostCount = 0;
      flightElapsed = 0;
      gimmickAnimTimer = 0;
      jumpQueuedPerfect = false;
      activeCrashMode = null;
      crashCameraFocus = 'chassis';
      crashTimer = 0;
      slowMoFactor = forceSlowMo ? 0.28 : 1.0;
      squashProgress = 0;
      tumbleBounceCount = 0;
      scatterStage = 0;
      detachedPartsCount = 0;
      maxWheelFlyDist = 0;

      activeCar.rootGroup.position.copy(carPos);
      activeCar.rootGroup.rotation.set(currentState === STATE.TITLE ? 0 : -carPitch, 0, 0);
      activeCar.squashGroup.scale.set(1, 1, 1);

      document.getElementById('hud-car-icon').textContent = spec.icon;
      document.getElementById('hud-car-name').textContent = spec.name;
