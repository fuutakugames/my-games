    // =========================================================================
    // 2. WEB AUDIO SYNTHESIZER
    // =========================================================================
    class SoundEngine {
      constructor() {
        this.ctx = null;
        this.enabled = true;
        this.engineOsc = null;
        this.engineGain = null;
        this.sirenTimer = 0;
      }

      init() {
        if (!this.ctx) {
          const AudioCtx = window.AudioContext || window.webkitAudioContext;
          if (AudioCtx) {
            this.ctx = new AudioCtx();
          }
        }
        if (this.ctx && this.ctx.state === 'suspended') {
          this.ctx.resume();
        }
      }

      toggle() {
        this.enabled = !this.enabled;
        this.init();
        if (!this.enabled) {
          this.stopEngine();
        }
        return this.enabled;
      }

      startEngine() {
        if (!this.enabled) return;
        this.init();
        if (!this.ctx || this.engineOsc) return;
        try {
          this.engineOsc = this.ctx.createOscillator();
          const filter = this.ctx.createBiquadFilter();
          this.engineGain = this.ctx.createGain();

          this.engineOsc.type = 'sawtooth';
          this.engineOsc.frequency.value = 55;
          filter.type = 'lowpass';
          filter.frequency.value = 380;
          this.engineGain.gain.value = 0.08;

          this.engineOsc.connect(filter);
          filter.connect(this.engineGain);
          this.engineGain.connect(this.ctx.destination);
          this.engineOsc.start();
        } catch (e) {}
      }

      updateEngine(speedRatio, carId, dt) {
        if (!this.enabled || !this.ctx) return;
        if (this.engineOsc) {
          const targetFreq = 55 + speedRatio * 220;
          this.engineOsc.frequency.setTargetAtTime(targetFreq, this.ctx.currentTime, 0.05);
        }
        if ((carId === 'police' || carId === 'ambulance' || carId === 'firetruck') && speedRatio > 0.15) {
          this.sirenTimer += dt;
          if (this.sirenTimer > 0.45) {
            this.sirenTimer = 0;
            this.playTone(this.sirenHigh ? 960 : 770, 0.35, 'sine', 0.06);
            this.sirenHigh = !this.sirenHigh;
          }
        }
      }

      stopEngine() {
        if (this.engineOsc) {
          try {
            this.engineOsc.stop();
            this.engineOsc.disconnect();
          } catch (e) {}
          this.engineOsc = null;
          this.engineGain = null;
        }
      }

      playTone(freq, duration, type = 'sine', vol = 0.12, slideTo = null) {
        if (!this.enabled) return;
        this.init();
        if (!this.ctx) return;
        try {
          const osc = this.ctx.createOscillator();
          const gain = this.ctx.createGain();
          osc.type = type;
          osc.frequency.setValueAtTime(freq, this.ctx.currentTime);
          if (slideTo) {
            osc.frequency.exponentialRampToValueAtTime(Math.max(20, slideTo), this.ctx.currentTime + duration);
          }
          gain.gain.setValueAtTime(vol, this.ctx.currentTime);
          gain.gain.exponentialRampToValueAtTime(0.001, this.ctx.currentTime + duration);
          osc.connect(gain);
          gain.connect(this.ctx.destination);
          osc.start();
          osc.stop(this.ctx.currentTime + duration);
        } catch (e) {}
      }

      playNoise(duration, filterFreq = 800, vol = 0.22) {
        if (!this.enabled) return;
        this.init();
        if (!this.ctx) return;
        try {
          const bufferSize = Math.floor(this.ctx.sampleRate * duration);
          const buffer = this.ctx.createBuffer(1, bufferSize, this.ctx.sampleRate);
          const data = buffer.getChannelData(0);
          for (let i = 0; i < bufferSize; i++) {
            data[i] = Math.random() * 2 - 1;
          }
          const noise = this.ctx.createBufferSource();
          noise.buffer = buffer;

          const filter = this.ctx.createBiquadFilter();
          filter.type = 'lowpass';
          filter.frequency.setValueAtTime(filterFreq, this.ctx.currentTime);
          filter.frequency.exponentialRampToValueAtTime(120, this.ctx.currentTime + duration);

          const gain = this.ctx.createGain();
          gain.gain.setValueAtTime(vol, this.ctx.currentTime);
          gain.gain.exponentialRampToValueAtTime(0.001, this.ctx.currentTime + duration);

          noise.connect(filter);
          filter.connect(this.ctx.destination);
          noise.start();
        } catch (e) {}
      }

      playJump(isPerfect) {
        this.playTone(220, 0.55, 'triangle', 0.16, isPerfect ? 980 : 680);
        if (isPerfect) {
          setTimeout(() => this.playTone(880, 0.35, 'sine', 0.14, 1320), 120);
        }
      }

      playBoost() {
        this.playNoise(0.35, 1600, 0.16);
        this.playTone(180, 0.35, 'sawtooth', 0.12, 620);
      }

      playCrash(mode) {
        this.stopEngine();
        if (mode === 'explode') {
          this.playNoise(0.95, 1200, 0.35);
          this.playTone(110, 0.8, 'sawtooth', 0.25, 28);
        } else if (mode === 'squash') {
          this.playNoise(0.55, 900, 0.28);
          this.playTone(260, 0.5, 'sawtooth', 0.22, 48);
        } else if (mode === 'water') {
          this.playNoise(0.85, 2200, 0.28);
          this.playTone(320, 0.4, 'sine', 0.15, 140);
        } else {
          this.playNoise(0.7, 1400, 0.3);
          this.playTone(140, 0.5, 'sawtooth', 0.2, 38);
        }
      }

      playPartBounce(isWheel = false) {
        if (Math.random() > 0.42) return;
        if (isWheel) {
          this.playTone(140 + Math.random() * 100, 0.12, 'sine', 0.07, 75);
        } else {
          this.playNoise(0.08, 1800, 0.08);
          this.playTone(420 + Math.random() * 750, 0.08, 'triangle', 0.05, 220);
        }
      }

      playSuccessFanfare() {
        this.stopEngine();
        const notes = [523.25, 659.25, 783.99, 1046.5];
        notes.forEach((n, idx) => {
          setTimeout(() => {
            this.playTone(n, 0.35, 'triangle', 0.16);
            this.playTone(n * 0.5, 0.35, 'sawtooth', 0.08);
          }, idx * 110);
        });
      }
    }

